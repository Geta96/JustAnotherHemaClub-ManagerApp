<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:JustAnotherHemaClub.Views"
       x:Class="JustAnotherHemaClub.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{StaticResource Cream}"
       FlyoutWidth="280"
       Shell.BackgroundColor="{StaticResource Wine}"
       Shell.ForegroundColor="{StaticResource OnPrimary}"
       Title="JAHC Manager">

    <!-- Flyout header: crest + user line -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Wine}" HeightRequest="240" Padding="16">
            <VerticalStackLayout VerticalOptions="Center"
                                 HorizontalOptions="Center"
                                 Spacing="10">
                <Image Source="monochrome_logo.jpg"
                       HeightRequest="170"
                       Aspect="AspectFit"
                       HorizontalOptions="Center" />
                <Label x:Name="UserLabel" Text=""
                       TextColor="{StaticResource Cream}" Opacity="0.8" FontSize="13"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid Padding="16,12" BackgroundColor="{StaticResource Cream}">
            <Label Text="© Just Another HEMA Club"
                   TextColor="{StaticResource Muted}" FontSize="12"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>

    <!-- Custom flyout item template for a sharper look -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="52" Padding="16,0"
                  ColumnDefinitions="28,*" ColumnSpacing="12">

                <Label Grid.Column="0"
                       FontSize="22"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Wine}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Label.Triggers>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Home">
                            <Setter Property="Text" Value="⌂" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Trainings">
                            <Setter Property="Text" Value="⚔" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Fencers">
                            <Setter Property="Text" Value="☰" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Finance">
                            <Setter Property="Text" Value="₣" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Statistics">
                            <Setter Property="Text" Value="▦" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="My Profile">
                            <Setter Property="Text" Value="◉" />
                        </DataTrigger>
                        <DataTrigger TargetType="Label" Binding="{Binding Title}" Value="Tournaments">
                            <Setter Property="Text" Value="⚑" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>

                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource Wine}"
                       FontSize="16" FontAttributes="Bold"
                       VerticalOptions="Center" />

                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource CreamSoft}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="48" Padding="16,0"
                  ColumnDefinitions="28,*" ColumnSpacing="12">
                <Label Grid.Column="0" Text="⎋"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource DangerRed}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="{Binding Title}"
                       TextColor="{StaticResource DangerRed}"
                       FontSize="15" FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <FlyoutItem Title="Home" Route="home">
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Trainings" Route="trainings">
        <ShellContent ContentTemplate="{DataTemplate views:TrainingsHubPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Tournaments" Route="tournaments">
        <ShellContent ContentTemplate="{DataTemplate views:TournamentsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Fencers" Route="fencers">
        <ShellContent ContentTemplate="{DataTemplate views:FencersPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Finance" Route="finance">
        <ShellContent ContentTemplate="{DataTemplate views:FinancePage}" />
    </FlyoutItem>

    <FlyoutItem x:Name="StatisticsFlyout" Title="Statistics" Route="statistics">
        <ShellContent ContentTemplate="{DataTemplate views:StatisticsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="My Profile" Route="profile">
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

    <MenuItem Text="Logout" Clicked="OnLogoutClicked" />
</Shell>