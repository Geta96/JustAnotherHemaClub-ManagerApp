<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:JustAnotherHemaClub.Views"
       x:Class="JustAnotherHemaClub.AppShell"
       FlyoutBehavior="Flyout"
       FlyoutBackgroundColor="{StaticResource Cream}"
       FlyoutWidth="280"
       Shell.BackgroundColor="{StaticResource Wine}"
       Shell.ForegroundColor="{StaticResource OnPrimary}"
       Title="JAHC Manager">

    <!-- Flyout header: crest + user line -->
    <Shell.FlyoutHeader>
        <Grid BackgroundColor="{StaticResource Wine}" HeightRequest="170" Padding="16">
            <VerticalStackLayout VerticalOptions="Center" Spacing="6">
                <Image Source="jahclogo.jpg"
                       HeightRequest="90"
                       Aspect="AspectFit"
                       HorizontalOptions="Start" />
                <Label Text="JAHC Manager" FontSize="20" FontAttributes="Bold"
                       TextColor="{StaticResource Cream}" />
                <Label x:Name="UserLabel" Text="" TextColor="{StaticResource Cream}" Opacity="0.8" FontSize="13" />
            </VerticalStackLayout>
        </Grid>
    </Shell.FlyoutHeader>

    <Shell.FlyoutFooter>
        <Grid Padding="16,12" BackgroundColor="{StaticResource Cream}">
            <Label Text="© Just Another HEMA Club"
                   TextColor="{StaticResource Muted}" FontSize="12"
                   HorizontalOptions="Center" />
        </Grid>
    </Shell.FlyoutFooter>

    <!-- Custom flyout item template for a sharper look -->
    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="52" Padding="16,0" ColumnDefinitions="6,*" ColumnSpacing="12">
                <BoxView Grid.Column="0" Color="{StaticResource Wine}"
                         WidthRequest="4" CornerRadius="2"
                         VerticalOptions="Fill" Margin="0,10" />
                <Label   Grid.Column="1"
                         Text="{Binding Title}"
                         TextColor="{StaticResource Wine}"
                         FontSize="16" FontAttributes="Bold"
                         VerticalOptions="Center" />
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Selected">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{StaticResource CreamSoft}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <Shell.MenuItemTemplate>
        <DataTemplate>
            <Grid HeightRequest="48" Padding="16,0">
                <Label Text="{Binding Title}"
                       TextColor="{StaticResource DangerRed}"
                       FontSize="15" FontAttributes="Bold"
                       VerticalOptions="Center" />
            </Grid>
        </DataTemplate>
    </Shell.MenuItemTemplate>

    <FlyoutItem Title="Home" Route="home">
        <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Trainings" Route="trainings">
        <ShellContent ContentTemplate="{DataTemplate views:TrainingsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Finance" Route="finance">
        <ShellContent ContentTemplate="{DataTemplate views:FinancePage}" />
    </FlyoutItem>

    <FlyoutItem Title="Statistics" Route="statistics">
        <ShellContent ContentTemplate="{DataTemplate views:StatisticsPage}" />
    </FlyoutItem>

    <FlyoutItem Title="My Profile" Route="profile">
        <ShellContent ContentTemplate="{DataTemplate views:ProfilePage}" />
    </FlyoutItem>

    <MenuItem Text="Logout" Clicked="OnLogoutClicked" />
</Shell>