<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.MatchPage"
             x:DataType="vm:MatchViewModel"
             Title="Match">

    <ScrollView>
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" Padding="16,8,16,16">

            <!-- Title + status -->
            <VerticalStackLayout Grid.Row="0" Spacing="2">
                <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                <Label Text="{Binding StatusBadge}" Style="{StaticResource Caption}" />
                <Label Text="{Binding LockHolderText}" Style="{StaticResource Caption}"
                       TextColor="{StaticResource DangerRed}"
                       IsVisible="{Binding LockHolderText, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=False}" />
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource DangerRed}"
                       IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=False}" />
            </VerticalStackLayout>

            <!-- Clock: Start/Stop button (left) | Time (center) | +1/-1/↺ (right) -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <!-- Start/Stop button -->
                    <Button Grid.Column="0"
                            Text="{Binding TimerButtonText}"
                            BackgroundColor="{Binding TimerButtonColor}"
                            TextColor="{StaticResource Cream}"
                            FontSize="14" FontAttributes="Bold"
                            HeightRequest="50" WidthRequest="70"
                            CornerRadius="8"
                            Opacity="{Binding EditOpacity}"
                            Command="{Binding ToggleTimerCommand}" />

                    <!-- Clock display -->
                    <Label Grid.Column="1"
                           Text="{Binding ClockText}"
                           FontSize="48" FontAttributes="Bold"
                           TextColor="{StaticResource Wine}"
                           VerticalOptions="Center"
                           HorizontalOptions="Center" />

                    <!-- +1 / -1 / ↺ stacked vertically -->
                    <VerticalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center"
                                         Opacity="{Binding EditOpacity}">
                        <Button Text="+1"
                                BackgroundColor="{StaticResource CreamSoft}"
                                TextColor="{StaticResource Wine}"
                                FontSize="14" FontAttributes="Bold"
                                HeightRequest="36" WidthRequest="50"
                                Padding="0"
                                Command="{Binding AddMinuteCommand}" />
                        <Button Text="-1"
                                BackgroundColor="{StaticResource CreamSoft}"
                                TextColor="{StaticResource Wine}"
                                FontSize="14" FontAttributes="Bold"
                                HeightRequest="36" WidthRequest="50"
                                Padding="0"
                                Command="{Binding SubtractMinuteCommand}" />
                        <Button Text="↺"
                                BackgroundColor="{StaticResource CreamSoft}"
                                TextColor="{StaticResource Wine}"
                                FontSize="18"
                                HeightRequest="36" WidthRequest="50"
                                Padding="0"
                                Command="{Binding RestartTimerCommand}" />
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- Mirrored score panels -->
            <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,10,0,0">

                <!-- LEFT fencer -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                        <Label Text="{Binding LeftName}"
                               Style="{StaticResource H2}" HorizontalOptions="Center" />

                        <!-- Card indicators (always reserve height) -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6"
                                               HeightRequest="24">
                            <Border BackgroundColor="#E6B800"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="24" HeightRequest="24"
                                    IsVisible="{Binding LeftShowYellowIndicator}" />
                            <Border BackgroundColor="{StaticResource DangerRed}"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="24" HeightRequest="24"
                                    IsVisible="{Binding LeftShowRedIndicator}">
                                <Label Text="{Binding LeftRedCountText}"
                                       TextColor="White" FontSize="11" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding LeftHasMultipleReds}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Card buttons row: Yellow | Red | ↺ -->
                        <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource CreamSoft}"
                                Padding="4"
                                Opacity="{Binding EditOpacity}">
                            <Grid ColumnDefinitions="*,*,36" ColumnSpacing="4">
                                <Button Grid.Column="0" Text="Yellow"
                                        BackgroundColor="#E6B800"
                                        TextColor="Black"
                                        FontSize="12" Padding="2,0"
                                        HeightRequest="36"
                                        Command="{Binding AddLeftYellowCommand}" />
                                <Button Grid.Column="1" Text="Red"
                                        BackgroundColor="{StaticResource DangerRed}"
                                        TextColor="{StaticResource Cream}"
                                        FontSize="12" Padding="2,0"
                                        HeightRequest="36"
                                        Command="{Binding AddLeftRedCommand}" />
                                <Button Grid.Column="2" Text="↺"
                                        BackgroundColor="#9E9E9E"
                                        TextColor="Black"
                                        FontSize="16"
                                        HeightRequest="36" WidthRequest="36"
                                        Padding="0"
                                        CornerRadius="6"
                                        Opacity="{Binding LeftUndoOpacity}"
                                        Command="{Binding RemoveLeftLastCardCommand}" />
                            </Grid>
                        </Border>

                        <Label Text="Score"
                               Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{Binding LeftScore}"
                               FontSize="64" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               HorizontalOptions="Center" />

                        <!-- Big +1 -->
                        <Button Text="+1"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                FontSize="32"
                                HeightRequest="80"
                                Opacity="{Binding EditOpacity}"
                                Command="{Binding AddLeftPointCommand}" />

                        <!-- -1 -->
                        <Button Text="-1"
                                BackgroundColor="{StaticResource Wine}"
                                TextColor="{StaticResource Cream}"
                                FontSize="14"
                                HeightRequest="36"
                                Opacity="{Binding EditOpacity}"
                                Command="{Binding SubLeftPointCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- RIGHT fencer -->
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Fill">
                        <Label Text="{Binding RightName}"
                               Style="{StaticResource H2}" HorizontalOptions="Center" />

                        <!-- Card indicators (always reserve height) -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="6"
                                               HeightRequest="24">
                            <Border BackgroundColor="#E6B800"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="24" HeightRequest="24"
                                    IsVisible="{Binding RightShowYellowIndicator}" />
                            <Border BackgroundColor="{StaticResource DangerRed}"
                                    StrokeShape="RoundRectangle 12"
                                    WidthRequest="24" HeightRequest="24"
                                    IsVisible="{Binding RightShowRedIndicator}">
                                <Label Text="{Binding RightRedCountText}"
                                       TextColor="White" FontSize="11" FontAttributes="Bold"
                                       HorizontalOptions="Center" VerticalOptions="Center"
                                       IsVisible="{Binding RightHasMultipleReds}" />
                            </Border>
                        </HorizontalStackLayout>

                        <!-- Card buttons row: Yellow | Red | ↺ -->
                        <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="{StaticResource CreamSoft}"
                                Padding="4"
                                Opacity="{Binding EditOpacity}">
                            <Grid ColumnDefinitions="*,*,36" ColumnSpacing="4">
                                <Button Grid.Column="0" Text="Yellow"
                                        BackgroundColor="#E6B800"
                                        TextColor="Black"
                                        FontSize="12" Padding="2,0"
                                        HeightRequest="36"
                                        Command="{Binding AddRightYellowCommand}" />
                                <Button Grid.Column="1" Text="Red"
                                        BackgroundColor="{StaticResource DangerRed}"
                                        TextColor="{StaticResource Cream}"
                                        FontSize="12" Padding="2,0"
                                        HeightRequest="36"
                                        Command="{Binding AddRightRedCommand}" />
                                <Button Grid.Column="2" Text="↺"
                                        BackgroundColor="#9E9E9E"
                                        TextColor="Black"
                                        FontSize="16"
                                        HeightRequest="36" WidthRequest="36"
                                        Padding="0"
                                        CornerRadius="6"
                                        Opacity="{Binding RightUndoOpacity}"
                                        Command="{Binding RemoveRightLastCardCommand}" />
                            </Grid>
                        </Border>

                        <Label Text="Score"
                               Style="{StaticResource Caption}" HorizontalOptions="Center" />
                        <Label Text="{Binding RightScore}"
                               FontSize="64" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               HorizontalOptions="Center" />

                        <!-- Big +1 -->
                        <Button Text="+1"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                FontSize="32"
                                HeightRequest="80"
                                Opacity="{Binding EditOpacity}"
                                Command="{Binding AddRightPointCommand}" />

                        <!-- -1 -->
                        <Button Text="-1"
                                BackgroundColor="{StaticResource Wine}"
                                TextColor="{StaticResource Cream}"
                                FontSize="14"
                                HeightRequest="36"
                                Opacity="{Binding EditOpacity}"
                                Command="{Binding SubRightPointCommand}" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- Update Match (reopen a finished match) -->
            <Button Grid.Row="3" Text="Update Match"
                    BackgroundColor="#E6B800"
                    TextColor="Black"
                    FontAttributes="Bold"
                    IsVisible="{Binding CanReopenMatch}"
                    Clicked="OnUpdateMatchClicked"
                    Margin="0,12,0,0" />

            <!-- Finish Match -->
            <Button Grid.Row="4" Text="Finish Match"
                    BackgroundColor="#1F8A2E"
                    TextColor="{StaticResource Cream}"
                    IsVisible="{Binding CanEdit}"
                    Clicked="OnFinishClicked"
                    Margin="0,12,0,0" />
        </Grid>
    </ScrollView>
</ContentPage>