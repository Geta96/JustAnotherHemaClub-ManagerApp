<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.NewTrainingPage"
             x:DataType="vm:TrainingsViewModel"
             Title="New training">
    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top: meta + search -->
        <VerticalStackLayout Grid.Row="0" Padding="16" Spacing="10">
            <Label Text="New training" Style="{StaticResource H1}" />

            <Label Text="Date" Style="{StaticResource Caption}" />
            <DatePicker Date="{Binding TrainingDate}" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0" Spacing="4">
                    <Label Text="Start time" Style="{StaticResource Caption}" />
                    <TimePicker Time="{Binding TrainingTime}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="4">
                    <Label Text="End time" Style="{StaticResource Caption}" />
                    <TimePicker Time="{Binding TrainingEndTime}" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Topic" Style="{StaticResource Caption}" />
            <Entry Placeholder="Topic" Text="{Binding Topic}" />

            <!-- Recurring weekly option -->
            <Border Style="{StaticResource Card}" Padding="12">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" VerticalOptions="Center">
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsRecurring}" />
                        <Label Grid.Column="1"
                               Text="Repeat weekly on this weekday"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding IsRecurring}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                <Label Text="Weekly start" Style="{StaticResource Caption}" />
                                <TimePicker Time="{Binding RecurringTime}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Weekly end" Style="{StaticResource Caption}" />
                                <TimePicker Time="{Binding RecurringEndTime}" />
                            </VerticalStackLayout>
                        </Grid>
                        <Label Text="{Binding RecurringSummary}" Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Grid.Column="0" Text="Attendees" Style="{StaticResource Caption}"
                       VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding SelectedCountLabel}"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Wine}"
                       VerticalOptions="Center" />
            </Grid>

            <Entry Placeholder="Search fencers by name or @username"
                   Text="{Binding AttendeeFilter, Mode=TwoWay}" />

            <HorizontalStackLayout Spacing="8">
                <Button Text="Select all (visible)"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding SelectAllVisibleAttendeesCommand}" />
                <Button Text="Clear"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding ClearAttendeesCommand}" />
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <!-- Middle: scrollable fencer list -->
        <CollectionView Grid.Row="1"
                        Margin="16,0,16,0"
                        ItemsSource="{Binding FilteredAttendees}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:FencerToggle">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Padding="6,6">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnAttendeeRowTapped" />
                        </Grid.GestureRecognizers>
                        <CheckBox Grid.Column="0" IsChecked="{Binding IsAttending}" />
                        <Label Grid.Column="1" Text="{Binding Fencer.Name}"
                               FontAttributes="Bold"
                               VerticalOptions="Center" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom: blue Create Training button -->
        <Button Grid.Row="2"
                Margin="16,8,16,16"
                Text="Create Training"
                BackgroundColor="#476FB5"
                TextColor="{StaticResource Cream}"
                Clicked="OnCreateClicked" />

        <!-- Loading overlay -->
        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="3"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                             IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               WidthRequest="48" HeightRequest="48" />
            <Label Text="Loading..." TextColor="{StaticResource Wine}" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>