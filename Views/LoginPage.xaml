<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Wine}">

    <Grid RowDefinitions="*,Auto">

        <!-- Crest area -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Fill"
                             Spacing="8" Padding="0">
            <Image Source="monochrome_logo.jpg"
                   HeightRequest="320"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill" />
            <Label Text="Manager"
                   FontSize="18" TextColor="{StaticResource Cream}" Opacity="0.7"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Sheet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,24" Padding="20">
            <VerticalStackLayout Spacing="12">
                <Label Text="Sign in" Style="{StaticResource H2}" />
                <Entry Placeholder="Username" Text="{Binding Username}" />
                <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                <Button Text="Login" Command="{Binding LoginCommand}" />

                <Button Text="Register as new fencer"
                        BackgroundColor="#476FB5"
                        TextColor="{StaticResource Cream}"
                        Command="{Binding GoToRegisterCommand}" />

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#FDECEC"
                        Stroke="{StaticResource DangerRed}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,8">
                    <Label Text="{Binding Error}"
                           TextColor="{StaticResource DangerRed}"
                           FontAttributes="Bold" />
                </Border>

                <Button Text="Forgot my password"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ForgotPasswordCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>