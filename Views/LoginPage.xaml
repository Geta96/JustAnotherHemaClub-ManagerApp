<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Wine}">

    <Grid RowDefinitions="*,Auto">

        <!-- Crest area -->
        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Fill"
                             Spacing="8" Padding="0">
            <Image Source="monochrome_logo.jpg"
                   HeightRequest="320"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill" />
            <Label Text="Manager"
                   FontSize="18" TextColor="{StaticResource Cream}" Opacity="0.7"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>

        <!-- Sheet -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,0,16,24" Padding="20">
            <VerticalStackLayout Spacing="12">
                <Label Text="Sign in" Style="{StaticResource H2}" />
                <Entry Placeholder="Username" Text="{Binding Username}" />
                <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />
                <Button Text="Login" Command="{Binding LoginCommand}" />
                <Button Text="Use as Guest" Command="{Binding UseAsGuestCommand}"
                        Style="{StaticResource SecondaryButton}" />
                <Button Text="Register as new fencer"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding GoToRegisterCommand}" />
                <Label Text="{Binding Error}" TextColor="{StaticResource DangerRed}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>