<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Wine}">

    <Grid>
        <!-- Crest area: centered in the whole screen; we offset it up when the card is showing -->
        <VerticalStackLayout x:Name="CrestGroup"
                             VerticalOptions="Center" HorizontalOptions="Fill"
                             Spacing="8" Padding="0">
            <Image Source="monochrome_logo.jpg"
                   HeightRequest="320"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill" />
            <Label Text="Manager"
                   FontSize="18" TextColor="{StaticResource Cream}" Opacity="0.7"
                   HorizontalOptions="Center" />

            <!-- Loading group: animated in/out from code-behind -->
            <VerticalStackLayout x:Name="LoadingGroup"
                                 Spacing="8" HorizontalOptions="Center"
                                 Opacity="0"
                                 TranslationY="20"
                                 InputTransparent="True">
                <Label Text="Logging in, please wait..."
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource Cream}"
                       HorizontalOptions="Center" />
                <ActivityIndicator IsRunning="{Binding IsSilentLoggingIn}"
                                   Color="{StaticResource Cream}"
                                   HorizontalOptions="Center" />
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- Sheet: overlays the bottom, doesn't push the crest -->
        <Border x:Name="SignInCard"
                Style="{StaticResource Card}"
                Margin="16,0,16,24" Padding="20"
                VerticalOptions="End"
                Opacity="0"
                TranslationY="40">
            <VerticalStackLayout Spacing="12">
                <Label Text="Sign in" Style="{StaticResource H2}" />
                <Entry Placeholder="Username" Text="{Binding Username}" />
                <Entry Placeholder="Password" IsPassword="True" Text="{Binding Password}" />

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <CheckBox IsChecked="{Binding KeepLoggedIn}" />
                    <Label Text="Keep me logged in"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <HorizontalStackLayout Spacing="8" VerticalOptions="Center"
                                       IsVisible="{Binding CanUseBiometric}">
                    <CheckBox IsChecked="{Binding UseBiometric}"
                              IsEnabled="{Binding KeepLoggedIn}" />
                    <Label Text="Use biometric unlock"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>

                <Button Text="Login" Command="{Binding LoginCommand}" />

                <Button Text="Sign in with biometrics"
                        Style="{StaticResource SecondaryButton}"
                        IsVisible="{Binding CanTryBiometricLogin}"
                        Command="{Binding TryBiometricLoginCommand}" />

                <Button Text="Register as new fencer"
                        BackgroundColor="#476FB5"
                        TextColor="{StaticResource Cream}"
                        Command="{Binding GoToRegisterCommand}" />

                <!-- Error banner -->
                <Border IsVisible="{Binding HasError}"
                        BackgroundColor="#FDECEC"
                        Stroke="{StaticResource DangerRed}" StrokeThickness="1"
                        StrokeShape="RoundRectangle 8"
                        Padding="10,8">
                    <Label Text="{Binding Error}"
                           TextColor="{StaticResource DangerRed}"
                           FontAttributes="Bold" />
                </Border>

                <Button Text="Forgot my password"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding ForgotPasswordCommand}" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>