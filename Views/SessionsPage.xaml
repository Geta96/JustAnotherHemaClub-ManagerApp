<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:m="clr-namespace:JustAnotherHemaClub.Models"
             x:Class="JustAnotherHemaClub.Views.SessionsPage"
             x:DataType="vm:SessionsViewModel"
             Title="Training Sessions">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="New session" Style="{StaticResource H2}" />
                    <DatePicker Date="{Binding SessionDate}" />
                    <Entry Placeholder="Topic" Text="{Binding Topic}" />

                    <Label Text="Attendees" Style="{StaticResource Caption}" />
                    <CollectionView ItemsSource="{Binding AllFencers}" SelectionMode="Multiple" HeightRequest="240">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="m:Fencer">
                                <Label Text="{Binding Name}" Padding="6" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Button Text="Save Session" Command="{Binding SaveSessionCommand}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Past sessions" Style="{StaticResource H2}" />
            <CollectionView ItemsSource="{Binding Sessions}">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:TrainingSession">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                            <VerticalStackLayout>
                                <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}" FontAttributes="Bold"
                                       TextColor="{StaticResource Wine}" />
                                <Label Text="{Binding Topic}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>