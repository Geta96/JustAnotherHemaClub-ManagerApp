<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:corevm="clr-namespace:JustAnotherHemaClub.ViewModels;assembly=JustAnotherHemaClub.Core"
             x:Class="JustAnotherHemaClub.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero (swipeable background carousel) -->
            <Grid Padding="0" HeightRequest="320">
                <CarouselView ItemsSource="{Binding HeroImages}"
                              Position="{Binding CurrentHeroImageIndex, Mode=TwoWay}"
                              Loop="True"
                              IsSwipeEnabled="True"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill">
                    <CarouselView.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Image Source="{Binding .}"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Fill"
                                   VerticalOptions="Fill" />
                        </DataTemplate>
                    </CarouselView.ItemTemplate>
                </CarouselView>

                <!-- Wine tint for legibility -->
                <BoxView Color="{StaticResource Wine}" Opacity="0.10"
                         InputTransparent="True"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />

                <!-- Foreground content -->
                <VerticalStackLayout Spacing="6" Padding="20,28,20,24"
                                     InputTransparent="True"
                                     HorizontalOptions="Fill" VerticalOptions="Center">
                    <Image Source="jahclogo.png"
                           HeightRequest="180"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Just Another HEMA Club"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Cream}"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource Wine}"
                                    Offset="0,0" Radius="5" Opacity="1" />
                        </Label.Shadow>
                    </Label>
                    <BoxView HeightRequest="2" WidthRequest="60" Color="{StaticResource Slate}"
                             HorizontalOptions="Center" />
                    <Label Text="Historical European Martial Arts in Budapest"
                           TextColor="{StaticResource Cream}" Opacity="1"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource Wine}"
                                    Offset="0,0" Radius="4" Opacity="1" />
                        </Label.Shadow>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- News (swipeable carousel, tapping opens all news) -->
                <Border Style="{StaticResource Card}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenAllNewsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="News" Style="{StaticResource H2}" FontSize="16" />

                        <Label Text="No news yet."
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding HasNoNews}" />

                        <CarouselView ItemsSource="{Binding News}"
                                      IndicatorView="newsIndicator"
                                      Loop="False"
                                      IsSwipeEnabled="True"
                                      HeightRequest="120"
                                      IsVisible="{Binding HasNews}">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="corevm:NewsRow">
                                    <Border Style="{StaticResource Card}" Padding="12,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=OpenAllNewsCommand}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       FontAttributes="Bold"
                                                       FontSize="16"
                                                       TextColor="{StaticResource Wine}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding DateText}"
                                                       Style="{StaticResource Caption}" />
                                            </Grid>
                                            <Label Text="{Binding Body}"
                                                   LineHeight="1.3"
                                                   MaxLines="3"
                                                   LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>

                        <IndicatorView x:Name="newsIndicator"
                                       IndicatorColor="{StaticResource Muted}"
                                       SelectedIndicatorColor="{StaticResource Wine}"
                                       HorizontalOptions="Center"
                                       IsVisible="{Binding HasNews}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pending password resets (instructors only) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasPendingResets}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pending password resets" Style="{StaticResource H2}" FontSize="16"/>
                        <Label Text="{Binding PendingResetsText}" LineBreakMode="WordWrap" />
                        <Button Text="Review requests"
                                BackgroundColor="{StaticResource Wine}"
                                TextColor="{StaticResource Cream}"
                                HeightRequest="48"
                                Command="{Binding OpenPendingResetsCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Pending payment requests (instructors only) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasPendingPaymentRequests}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Pending payment requests" Style="{StaticResource H2}" FontSize="16" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding PendingPaymentRequests}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="corevm:PaymentRequestRow">
                                    <Border Style="{StaticResource Card}">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Grid.Column="0" Text="{Binding FencerName}"
                                                       FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                                <Label Grid.Column="1" Text="{Binding AmountText}"
                                                       FontAttributes="Bold" TextColor="{StaticResource Slate}" />
                                            </Grid>
                                            <Label Text="{Binding PeriodText, StringFormat='For {0}'}"
                                                   Style="{StaticResource Caption}" />
                                            <Label Text="{Binding Request.Note}"
                                                   IsVisible="{Binding HasNote}"
                                                   Style="{StaticResource Caption}" />
                                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                                <Button Grid.Column="0" Text="Accept"
                                                        BackgroundColor="#1F8A2E"
                                                        TextColor="{StaticResource Cream}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=AcceptPaymentRequestCommand}"
                                                        CommandParameter="{Binding .}" />
                                                <Button Grid.Column="1" Text="Reject"
                                                        BackgroundColor="{StaticResource DangerRed}"
                                                        TextColor="{StaticResource Cream}"
                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, Path=RejectPaymentRequestCommand}"
                                                        CommandParameter="{Binding .}" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Next lesson -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasNextLesson}"
                        Stroke="{Binding NextLessonStroke}"
                        StrokeThickness="{Binding NextLessonStrokeThickness}">
                    <Border.Shadow>
                        <Shadow Brush="#7FBF3F" Offset="0,0" Radius="14"
                                Opacity="{Binding NextLessonGlowOpacity}" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Text="Next lesson:" Style="{StaticResource H2}"
                                   FontSize="16" />
                            <Label Text="{Binding NextLessonWhen}"
                                   FontSize="18" FontAttributes="Bold"
                                   TextColor="{StaticResource Wine}" />
                            <Label Text="{Binding NextLessonTopic}"
                                   Style="{StaticResource Caption}"
                                   IsVisible="{Binding NextLessonHasTopic}" />
                        </VerticalStackLayout>

                        <!-- Blue Attend button (taller, nudged left via right margin) -->
                        <Button Grid.Column="1"
                                Text="Attend"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                HeightRequest="48" Padding="18,0"
                                FontSize="16"
                                Margin="0,0,10,0"
                                VerticalOptions="Center"
                                IsVisible="{Binding ShowAttendButton}"
                                Command="{Binding ToggleAttendNextLessonCommand}" />

                        <!-- After attending: Wine "Undo" text with a larger glyph -->
                        <HorizontalStackLayout Grid.Column="1" Spacing="6"
                                               Margin="0,0,10,0"
                                               VerticalOptions="Center"
                                               IsVisible="{Binding ShowUndoAttend}">
                            <HorizontalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleAttendNextLessonCommand}" />
                            </HorizontalStackLayout.GestureRecognizers>
                            <Label Text="&#x21A9;"
                                   TextColor="{StaticResource Wine}"
                                   FontSize="24" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                            <Label Text="Undo"
                                   TextColor="{StaticResource Wine}"
                                   FontSize="16" FontAttributes="Bold"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Grid>
                </Border>

                <!-- Weekly training (dynamic) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Weekly trainings" Style="{StaticResource H2}" FontSize="16"/>

                        <ActivityIndicator IsRunning="{Binding IsLoadingWeekly}"
                                           IsVisible="{Binding IsLoadingWeekly}"
                                           Color="{StaticResource Wine}"
                                           HorizontalOptions="Start" />

                        <Label Text="No weekly trainings scheduled."
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding HasNoWeeklyTrainings}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeeklyTrainings}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeWeeklyRow">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding DayShort}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding TimeRange}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                        <Label Text="{Binding Topic}"
                                               Style="{StaticResource Caption}"
                                               Margin="60,0,0,0"
                                               IsVisible="{Binding HasTopic}" />
                                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.4"
                                                 Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Payment status (logged-in fencer only, expandable and collapsed by default) -->
                <Border Style="{StaticResource Card}" IsVisible="{Binding HasPaymentStatus}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePaymentStatusCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Text="{Binding PaymentStatusExpandGlyph}"
                                   FontSize="20" FontAttributes="Bold"
                                   TextColor="{StaticResource Wine}"
                                   VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Payment status" Style="{StaticResource H2}" FontSize="16" />
                                <Label Text="{Binding PaymentStatusText}"
                                       TextColor="{Binding PaymentStatusColor}"
                                       FontSize="18" FontAttributes="Bold"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout IsVisible="{Binding IsPaymentStatusExpanded}" Spacing="8">
                            <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.3" Margin="0,2" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding PaymentMonths}" Spacing="8">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:HomePaymentMonthRow">
                                        <Border Style="{StaticResource Card}">
                                            <VerticalStackLayout Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ToggleOptionsCommand}" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Grid.Row="0" Grid.Column="0"
                                                           Text="{Binding MonthTitle}"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Wine}" />
                                                    <Label Grid.Row="1" Grid.Column="0"
                                                           Text="{Binding Due.Summary}"
                                                           Style="{StaticResource Caption}" />

                                                    <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                           Spacing="6"
                                                                           VerticalOptions="Center"
                                                                           IsVisible="{Binding Due.IsNotPaid}">
                                                        <Label Text="{Binding Due.AmountDue, StringFormat='Owes {0:N0} Ft'}"
                                                               TextColor="{StaticResource DangerRed}"
                                                               FontAttributes="Bold"
                                                               FontSize="16"
                                                               HorizontalTextAlignment="End"
                                                               VerticalOptions="Center" />
                                                    </HorizontalStackLayout>

                                                    <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                           Text="✓ Paid"
                                                           IsVisible="{Binding Due.IsExactlyPaid}"
                                                           TextColor="#1F8A2E" FontAttributes="Bold" FontSize="16"
                                                           VerticalOptions="Center" />

                                                    <VerticalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                         IsVisible="{Binding Due.IsOverpaid}"
                                                                         Spacing="0"
                                                                         MaximumWidthRequest="150"
                                                                         HorizontalOptions="End"
                                                                         VerticalOptions="Center">
                                                        <Label Text="{Binding Due.OverpaymentPrimary, StringFormat='✓ {0}'}"
                                                               TextColor="#1F8A2E" FontAttributes="Bold" FontSize="14"
                                                               LineBreakMode="WordWrap"
                                                               HorizontalTextAlignment="End" />
                                                        <Label Text="{Binding Due.OverpaymentOverpay}"
                                                               IsVisible="{Binding Due.HasOverpaymentOverpay}"
                                                               TextColor="#1F8A2E" FontAttributes="Bold" FontSize="14"
                                                               LineBreakMode="WordWrap"
                                                               HorizontalTextAlignment="End" />
                                                    </VerticalStackLayout>
                                                </Grid>

                                                <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.2" />

                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                    <Grid.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding ToggleOptionsCommand}" />
                                                    </Grid.GestureRecognizers>
                                                    <Label Grid.Column="0"
                                                           Text="{Binding OptionsExpandGlyph}"
                                                           FontSize="16" FontAttributes="Bold"
                                                           TextColor="{StaticResource Wine}"
                                                           VerticalOptions="Center" />
                                                    <Label Grid.Column="1"
                                                           Text="Ask to accept payment"
                                                           FontAttributes="Bold"
                                                           TextColor="{StaticResource Wine}"
                                                           VerticalOptions="Center" />
                                                </Grid>

                                                <VerticalStackLayout IsVisible="{Binding IsOptionsExpanded}" Spacing="8">
                                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding PaymentOptions}" Spacing="8">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="corevm:PaymentOptionVm">
                                                                <Button Text="{Binding Text}"
                                                                        HeightRequest="48"
                                                                        FontAttributes="Bold"
                                                                        CornerRadius="10"
                                                                        BackgroundColor="{StaticResource CreamSoft}"
                                                                        TextColor="{StaticResource Wine}"
                                                                        BorderColor="{StaticResource Wine}"
                                                                        BorderWidth="1.5"
                                                                        Command="{Binding ChooseCommand}">
                                                                    <Button.Triggers>
                                                                        <DataTrigger TargetType="Button"
                                                                                     Binding="{Binding IsPrimary}"
                                                                                     Value="True">
                                                                            <Setter Property="BackgroundColor" Value="{StaticResource Wine}" />
                                                                            <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                                                            <Setter Property="BorderWidth" Value="0" />
                                                                            <Setter Property="FontSize" Value="16" />
                                                                        </DataTrigger>
                                                                        <DataTrigger TargetType="Button"
                                                                                     Binding="{Binding IsRemaining}"
                                                                                     Value="True">
                                                                            <Setter Property="BackgroundColor" Value="#476FB5" />
                                                                            <Setter Property="TextColor" Value="{StaticResource Cream}" />
                                                                            <Setter Property="BorderWidth" Value="0" />
                                                                            <Setter Property="FontSize" Value="16" />
                                                                        </DataTrigger>
                                                                    </Button.Triggers>
                                                                </Button>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="About us" Style="{StaticResource H2}" FontSize="16"/>
                        <Label Text="We're a HEMA (Historical European Martial Arts) club located in Budapest focused on longsword, footwork drills and free sparring."
                               LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Social -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Follow or Contact us" Style="{StaticResource H2}" FontSize="16"/>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Instagram"
                                    BackgroundColor="#C13584" TextColor="{StaticResource Cream}"
                                    Command="{Binding OpenInstagramCommand}" />
                            <Button Grid.Column="1" Text="Facebook"
                                    BackgroundColor="#1877F2" TextColor="{StaticResource Cream}"
                                    Command="{Binding OpenFacebookCommand}" />
                        </Grid>
                        <Button Text="Discord"
                                BackgroundColor="#5865F2" TextColor="{StaticResource Cream}"
                                Command="{Binding OpenDiscordCommand}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Club HEMA Ratings"
                                    BackgroundColor="{StaticResource HemaRatingsBg}"
                                    TextColor="{StaticResource HemaRatingsText}"
                                    Command="{Binding OpenClubHemaRatingsCommand}" />
                            <Button Grid.Column="1" Text="MHS Tournament Calendar"
                                    BackgroundColor="#1F7A6C"
                                    TextColor="#EAF6F3"
                                    Command="{Binding OpenMhsCalendarCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="More info coming soon."
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>