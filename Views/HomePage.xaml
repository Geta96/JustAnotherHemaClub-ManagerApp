<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.HomePage"
             x:DataType="vm:HomeViewModel"
             Title="Home">
    <ScrollView>
        <VerticalStackLayout Spacing="0">

            <!-- Hero -->
            <Grid Padding="0" HeightRequest="320">
                <!-- Background image -->
                <Image Source="home_bg_2.jpg"
                       Aspect="AspectFill"
                       HorizontalOptions="Fill"
                       VerticalOptions="Fill" />
                <!-- Wine tint for legibility -->
                <BoxView Color="{StaticResource Wine}" Opacity="0.10"
                         HorizontalOptions="Fill" VerticalOptions="Fill" />
                <!-- Foreground content -->
                <VerticalStackLayout Spacing="6" Padding="20,28,20,24"
                                     HorizontalOptions="Center" VerticalOptions="Center">
                    <Image Source="jahclogo.png"
                           HeightRequest="180"
                           Aspect="AspectFit"
                           HorizontalOptions="Center" />
                    <Label Text="Just Another HEMA Club"
                           FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Cream}"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource Wine}"
                                    Offset="0,0" Radius="5" Opacity="1" />
                        </Label.Shadow>
                    </Label>
                    <BoxView HeightRequest="2" WidthRequest="60" Color="{StaticResource Slate}"
                             HorizontalOptions="Center" />
                    <Label Text="Historical European Martial Arts in Budapest"
                           TextColor="{StaticResource Cream}" Opacity="1"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Center"
                           LineBreakMode="WordWrap">
                        <Label.Shadow>
                            <Shadow Brush="{StaticResource Wine}"
                                    Offset="0,0" Radius="4" Opacity="1" />
                        </Label.Shadow>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <VerticalStackLayout Padding="16" Spacing="14">

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="About us" Style="{StaticResource H2}" />
                        <Label Text="We're a HEMA (Historical European Martial Arts) club located in Budapest focused on longsword, footwork drills and free sparring. Beginners are welcome — come watch a session or jump straight in."
                               LineHeight="1.3" />
                    </VerticalStackLayout>
                </Border>

                <!-- Weekly training (dynamic) -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Weekly trainings" Style="{StaticResource H2}" />

                        <ActivityIndicator IsRunning="{Binding IsLoadingWeekly}"
                                           IsVisible="{Binding IsLoadingWeekly}"
                                           Color="{StaticResource Wine}"
                                           HorizontalOptions="Start" />

                        <Label Text="No weekly trainings scheduled."
                               Style="{StaticResource Caption}"
                               IsVisible="{Binding HasNoWeeklyTrainings}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding WeeklyTrainings}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:HomeWeeklyRow">
                                    <VerticalStackLayout Spacing="2">
                                        <Grid ColumnDefinitions="60,*" ColumnSpacing="10">
                                            <Label Grid.Column="0"
                                                   Text="{Binding DayShort}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding TimeRange}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                        <Label Text="{Binding Topic}"
                                               Style="{StaticResource Caption}"
                                               Margin="60,0,0,0"
                                               IsVisible="{Binding HasTopic}" />
                                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.4"
                                                 Margin="0,4,0,0" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Social -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Follow or Contact us" Style="{StaticResource H2}" />
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="Instagram"
                                    BackgroundColor="#C13584" TextColor="{StaticResource Cream}"
                                    Command="{Binding OpenInstagramCommand}" />
                            <Button Grid.Column="1" Text="Facebook"
                                    BackgroundColor="#1877F2" TextColor="{StaticResource Cream}"
                                    Command="{Binding OpenFacebookCommand}" />
                        </Grid>
                        <Button Text="Telegram"
                                BackgroundColor="#229ED9" TextColor="{StaticResource Cream}"
                                Command="{Binding OpenTelegramCommand}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="More info coming soon."
                       Style="{StaticResource Caption}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>