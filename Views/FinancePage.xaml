<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:m="clr-namespace:JustAnotherHemaClub.Models"
             xmlns:sel="clr-namespace:JustAnotherHemaClub.Selectors"
             x:Class="JustAnotherHemaClub.Views.FinancePage"
             x:DataType="vm:FinanceViewModel"
             Title="Finance">

    <ContentPage.Resources>

        <!-- =================== MONTHLY TAB =================== -->
        <DataTemplate x:Key="MonthlyTabTemplate"
                      x:DataType="vm:FinanceTab">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,16" Spacing="14">

                    <!-- Personal summary -->
                    <Border Style="{StaticResource Card}"
                            IsVisible="{Binding Vm.ShowPersonalSummary}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="My payments" Style="{StaticResource H2}" />

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center"
                                                   IsVisible="{Binding Vm.PersonalAllPaid}">
                                <Label Text="✓" FontSize="22" FontAttributes="Bold"
                                       TextColor="#1F8A2E" VerticalOptions="Center" />
                                <Label Text="All payed up. Thank you!"
                                       FontAttributes="Bold"
                                       TextColor="#1F8A2E"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <HorizontalStackLayout.Triggers>
                                    <DataTrigger TargetType="HorizontalStackLayout"
                                                 Binding="{Binding Vm.PersonalAllPaid}"
                                                 Value="True">
                                        <Setter Property="IsVisible" Value="False" />
                                    </DataTrigger>
                                </HorizontalStackLayout.Triggers>
                                <Label Text="✗" FontSize="22" FontAttributes="Bold"
                                       TextColor="{StaticResource DangerRed}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding Vm.PersonalTotalDue, StringFormat='{0:N0} Ft is due'}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource DangerRed}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Monthly breakdown (flat) -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vm.Months}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthFinanceVm">
                                <Border Style="{StaticResource Card}">
                                    <VerticalStackLayout Spacing="10">

                                        <!-- Month header -->
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Grid.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                            </Grid.GestureRecognizers>
                                            <Label Grid.Column="0" Text="{Binding ExpandGlyph}"
                                                   FontSize="20" TextColor="{StaticResource Wine}"
                                                   VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1">
                                                <Label Text="{Binding Title}" Style="{StaticResource H2}" />
                                                <Label Text="{Binding Summary}" Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <!-- Month body -->
                                        <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="12">

                                            <Label Text="Dues" FontAttributes="Bold" TextColor="{StaticResource Wine}" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Dues}" Spacing="6">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:FencerDueRow">
                                                        <Border Style="{StaticResource Card}">
                                                            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                                                <Label Grid.Row="0" Grid.Column="0"
                                                                       Text="{Binding Fencer.Name}" FontAttributes="Bold"
                                                                       TextColor="{StaticResource Wine}" />
                                                                <Label Grid.Row="1" Grid.Column="0"
                                                                       Text="{Binding Summary}" Style="{StaticResource Caption}" />

                                                                <Button Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                        Text="Mark Paid"
                                                                        IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}"
                                                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.MarkPaidCommand}"
                                                                        CommandParameter="{Binding .}"
                                                                        VerticalOptions="Center">
                                                                    <Button.Triggers>
                                                                        <DataTrigger TargetType="Button"
                                                                                     Binding="{Binding IsPaid}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible" Value="False" />
                                                                        </DataTrigger>
                                                                    </Button.Triggers>
                                                                </Button>

                                                                <HorizontalStackLayout Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                                       Spacing="6"
                                                                                       VerticalOptions="Center"
                                                                                       IsVisible="{Binding IsNotPaid}">
                                                                    <HorizontalStackLayout.Triggers>
                                                                        <DataTrigger TargetType="HorizontalStackLayout"
                                                                                     Binding="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}"
                                                                                     Value="True">
                                                                            <Setter Property="IsVisible" Value="False" />
                                                                        </DataTrigger>
                                                                    </HorizontalStackLayout.Triggers>
                                                                    <Label Text="Not payed yet"
                                                                           TextColor="{StaticResource DangerRed}"
                                                                           FontAttributes="Bold"
                                                                           VerticalOptions="Center" />
                                                                    <Label Text="✗"
                                                                           FontSize="20" FontAttributes="Bold"
                                                                           TextColor="{StaticResource DangerRed}"
                                                                           VerticalOptions="Center" />
                                                                </HorizontalStackLayout>

                                                                <!-- Exactly paid: outstanding=0 AND no overpayment. -->
                                                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                       Text="✓ Paid"
                                                                       IsVisible="{Binding IsExactlyPaid}"
                                                                       TextColor="#1F8A2E" FontAttributes="Bold" FontSize="18"
                                                                       VerticalOptions="Center" />

                                                                <!-- Overpaid: replaces "Paid" so the credit going forward is visible. -->
                                                                <Label Grid.Row="0" Grid.RowSpan="2" Grid.Column="1"
                                                                       Text="{Binding Overpayment, StringFormat='✓ Overpayed by {0:N0} Ft'}"
                                                                       IsVisible="{Binding IsOverpaid}"
                                                                       TextColor="#1F8A2E" FontAttributes="Bold" FontSize="14"
                                                                       LineBreakMode="WordWrap"
                                                                       HorizontalTextAlignment="End"
                                                                       VerticalOptions="Center" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Label Text="Expenses" FontAttributes="Bold" TextColor="{StaticResource Wine}"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Expenses}" Spacing="6"
                                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="m:Expense">
                                                        <Border Style="{StaticResource Card}">
                                                            <VerticalStackLayout>
                                                                <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                                                       FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                                                <Label Text="{Binding Category}" />
                                                                <Label Text="{Binding Description}" />
                                                                <Label Text="{Binding Amount, StringFormat='{0:N0}'}"
                                                                       TextColor="{StaticResource Slate}" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Border Style="{StaticResource Card}"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}">
                                                <VerticalStackLayout Spacing="8">
                                                    <!-- Money OUT trigger: desaturated wine to read as a "cost" affordance. -->
                                                    <Button Text="Add Expense"
                                                            BackgroundColor="{StaticResource Muted}"
                                                            TextColor="{StaticResource Cream}"
                                                            IsVisible="{Binding IsAddingExpense, Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding BeginAddExpenseCommand}" />

                                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAddingExpense}">
                                                        <Label Text="Add expense" FontAttributes="Bold"
                                                               TextColor="{StaticResource Wine}" />
                                                        <Entry Placeholder="Category" Text="{Binding NewExpenseCategory}" />
                                                        <Entry Placeholder="Description" Text="{Binding NewExpenseDescription}" />
                                                        <Entry Placeholder="Amount" Keyboard="Numeric" Text="{Binding NewExpenseAmount}" />

                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                            <Button Grid.Column="0" Text="Cancel"
                                                                    BackgroundColor="{StaticResource Wine}"
                                                                    TextColor="{StaticResource Cream}"
                                                                    Command="{Binding CancelAddExpenseCommand}" />
                                                            <Button Grid.Column="1" Text="Save"
                                                                    BackgroundColor="{StaticResource Muted}"
                                                                    TextColor="{StaticResource Cream}"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.AddExpenseCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>

                                            <!-- ===== Income (one-off, non-dues): donations, gear sales, fencers paying for extras. ===== -->
                                            <Label Text="Income" FontAttributes="Bold" TextColor="{StaticResource Wine}"
                                                   IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}" />

                                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Incomes}" Spacing="6"
                                                                 IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate x:DataType="m:Income">
                                                        <Border Style="{StaticResource Card}">
                                                            <VerticalStackLayout>
                                                                <Label Text="{Binding Date, StringFormat='{0:yyyy-MM-dd}'}"
                                                                       FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                                                <Label Text="{Binding Category}" />
                                                                <Label Text="{Binding Description}" />
                                                                <Label Text="{Binding Amount, StringFormat='{0:N0}'}"
                                                                       TextColor="{StaticResource Slate}" />
                                                            </VerticalStackLayout>
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </VerticalStackLayout>

                                            <Border Style="{StaticResource Card}"
                                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.IsLoggedInInstructor}">
                                                <VerticalStackLayout Spacing="8">
                                                    <!-- Money IN trigger: blue, to read as a "deposit" affordance. -->
                                                    <Button Text="Add Income"
                                                            BackgroundColor="#476FB5"
                                                            TextColor="{StaticResource Cream}"
                                                            IsVisible="{Binding IsAddingIncome, Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding BeginAddIncomeCommand}" />

                                                    <VerticalStackLayout Spacing="8" IsVisible="{Binding IsAddingIncome}">
                                                        <Label Text="Add income" FontAttributes="Bold"
                                                               TextColor="{StaticResource Wine}" />
                                                        <Entry Placeholder="Category" Text="{Binding NewIncomeCategory}" />
                                                        <Entry Placeholder="Description" Text="{Binding NewIncomeDescription}" />
                                                        <Entry Placeholder="Amount" Keyboard="Numeric" Text="{Binding NewIncomeAmount}" />

                                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                            <Button Grid.Column="0" Text="Cancel"
                                                                    BackgroundColor="{StaticResource Wine}"
                                                                    TextColor="{StaticResource Cream}"
                                                                    Command="{Binding CancelAddIncomeCommand}" />
                                                            <Button Grid.Column="1" Text="Save"
                                                                    BackgroundColor="#476FB5"
                                                                    TextColor="{StaticResource Cream}"
                                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.AddIncomeCommand}"
                                                                    CommandParameter="{Binding .}" />
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </VerticalStackLayout>
                                            </Border>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>

        <!-- =================== YEARLY TAB =================== -->
        <DataTemplate x:Key="YearlyTabTemplate"
                      x:DataType="vm:FinanceTab">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,16" Spacing="14">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="{Binding Vm.Year, StringFormat='{0}'}" Style="{StaticResource H2}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="Income" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.YearIncome, StringFormat='{0:N0}'}"
                                           FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Slate}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="Expenses" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.YearExpenses, StringFormat='{0:N0}'}"
                                           FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Label Text="Balance" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.YearBalance, StringFormat='{0:N0}'}"
                                           FontSize="22" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                                    <Label Text="Sessions" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.YearSessions}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                    <Label Text="Avg attendance" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.YearAvgAttendance, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>

        <!-- =================== ALL TIME TAB =================== -->
        <DataTemplate x:Key="AllTimeTabTemplate"
                      x:DataType="vm:FinanceTab">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,16" Spacing="14">
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="All time" Style="{StaticResource H2}" />
                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="6">
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0">
                                    <Label Text="Income" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.AllTimeIncome, StringFormat='{0:N0}'}"
                                           FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Slate}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1">
                                    <Label Text="Expenses" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.AllTimeExpenses, StringFormat='{0:N0}'}"
                                           FontSize="20" FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <Label Text="Balance" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.AllTimeBalance, StringFormat='{0:N0}'}"
                                           FontSize="26" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="0">
                                    <Label Text="Sessions" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.AllTimeSessions}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2" Grid.Column="1">
                                    <Label Text="Avg attendance" Style="{StaticResource Caption}" />
                                    <Label Text="{Binding Vm.AllTimeAvgAttendance, StringFormat='{0:N2}'}" FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>
                            <Label Text="{Binding Vm.ActiveFencers, StringFormat='Active fencers: {0}'}"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>

        <!-- =================== PRICES TAB (instructor-only) =================== -->
        <DataTemplate x:Key="PricesTabTemplate"
                      x:DataType="vm:FinanceTab">
            <ScrollView>
                <VerticalStackLayout Padding="16,8,16,16" Spacing="14">

                    <!-- Add new price rule -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Button Text="Add Price Rule"
                                    BackgroundColor="#476FB5"
                                    TextColor="{StaticResource Cream}"
                                    IsVisible="{Binding Vm.PricesVm.IsAddingRule, Converter={StaticResource InverseBoolConverter}}"
                                    Command="{Binding Vm.PricesVm.BeginAddRuleCommand}" />

                            <VerticalStackLayout Spacing="8" IsVisible="{Binding Vm.PricesVm.IsAddingRule}">
                                <Label Text="New price rule" FontAttributes="Bold"
                                       TextColor="{StaticResource Wine}" />

                                <Label Text="Applies to" Style="{StaticResource Caption}" />
                                <Picker ItemsSource="{Binding Vm.PricesVm.SessionCountOptions}"
                                        SelectedIndex="{Binding Vm.PricesVm.NewSessionCountIndex, Mode=TwoWay}" />

                                <Label Text="Full price (Ft)" Style="{StaticResource Caption}" />
                                <Entry Keyboard="Numeric" Text="{Binding Vm.PricesVm.NewFullPrice}" />

                                <Label Text="Student price (Ft) — discounted price made made for students"
                                       Style="{StaticResource Caption}" />
                                <Entry Keyboard="Numeric" Text="{Binding Vm.PricesVm.NewStudentPrice}" />

                                <Label Text="Start date" Style="{StaticResource Caption}" />
                                <DatePicker Date="{Binding Vm.PricesVm.NewStartDate}" />

                                <HorizontalStackLayout Spacing="8">
                                    <CheckBox IsChecked="{Binding Vm.PricesVm.NewHasEndDate}" />
                                    <Label Text="Has end date" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <DatePicker Date="{Binding Vm.PricesVm.NewEndDate}"
                                            IsVisible="{Binding Vm.PricesVm.NewHasEndDate}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                    <Button Grid.Column="0" Text="Cancel"
                                            BackgroundColor="{StaticResource Wine}"
                                            TextColor="{StaticResource Cream}"
                                            Command="{Binding Vm.PricesVm.CancelAddRuleCommand}" />
                                    <Button Grid.Column="1" Text="Save"
                                            BackgroundColor="#476FB5"
                                            TextColor="{StaticResource Cream}"
                                            Command="{Binding Vm.PricesVm.SaveNewRuleCommand}" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Empty-state -->
                    <Label Text="No price rules yet. Add one above (the app falls back to defaults until you do)."
                           IsVisible="{Binding Vm.PricesVm.HasNoRules}"
                           Style="{StaticResource Caption}" />

                    <!-- Existing rules — active first, and all collapsed by default -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Vm.PricesVm.Rules}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:PriceRuleRow">
                                <VerticalStackLayout Spacing="0">
                                    <Border Style="{StaticResource Card}">
                                        <VerticalStackLayout Spacing="10">

                                            <!-- Header -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                                <Grid.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding ToggleExpandedCommand}" />
                                                </Grid.GestureRecognizers>
                                                <Label Grid.Column="0" Text="{Binding ExpandGlyph}"
                                                       FontSize="20" TextColor="{StaticResource Wine}"
                                                       VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1">
                                                    <Label Text="{Binding TierName}" Style="{StaticResource H2}" />
                                                    <Label Text="{Binding PriceSummary}" Style="{StaticResource Caption}" />
                                                    <Label Text="{Binding DateRange}" Style="{StaticResource Caption}" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2" Text="{Binding ActiveBadge}"
                                                       VerticalOptions="Center" FontAttributes="Bold"
                                                       TextColor="{StaticResource Wine}" />
                                            </Grid>

                                            <!-- Body -->
                                            <VerticalStackLayout IsVisible="{Binding IsExpanded}" Spacing="8">
                                                <Label Text="Full price (Ft)" Style="{StaticResource Caption}" />
                                                <Entry Keyboard="Numeric" Text="{Binding FullPrice}" />

                                                <Label Text="Student price (Ft)" Style="{StaticResource Caption}" />
                                                <Entry Keyboard="Numeric" Text="{Binding StudentPrice}" />

                                                <Label Text="Start date" Style="{StaticResource Caption}" />
                                                <DatePicker Date="{Binding StartDate}" />

                                                <HorizontalStackLayout Spacing="8">
                                                    <CheckBox IsChecked="{Binding HasEndDate}" />
                                                    <Label Text="Has end date" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <DatePicker Date="{Binding EndDate}"
                                                            IsVisible="{Binding HasEndDate}" />

                                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                                    <Button Grid.Column="0" Text="Delete"
                                                            BackgroundColor="{StaticResource DangerRed}"
                                                            TextColor="{StaticResource Cream}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.PricesVm.DeleteRuleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                    <Button Grid.Column="1" Text="Save changes"
                                                            BackgroundColor="#476FB5"
                                                            TextColor="{StaticResource Cream}"
                                                            IsEnabled="{Binding IsDirty}"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:FinanceTab}}, Path=Vm.PricesVm.SaveRuleCommand}"
                                                            CommandParameter="{Binding .}" />
                                                </Grid>
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Border>

                                    <!-- Active/inactive boundary divider. Visible only on the
                                         last active rule, and only when at least one inactive
                                         rule follows. IsVisible=False removes it from layout. -->
                                    <BoxView HeightRequest="1"
                                             BackgroundColor="{StaticResource Wine}"
                                             Margin="8,8,8,0"
                                             IsVisible="{Binding ShowActiveSeparator}" />
                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </DataTemplate>

        <sel:FinanceTabTemplateSelector x:Key="TabSelector"
                                        MonthlyTemplate="{StaticResource MonthlyTabTemplate}"
                                        YearlyTemplate="{StaticResource YearlyTabTemplate}"
                                        AllTimeTemplate="{StaticResource AllTimeTabTemplate}"
                                        PricesTemplate="{StaticResource PricesTabTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,Auto,*">

        <!-- Title + refresh -->
        <Grid Grid.Row="0" Padding="16,16,16,0"
              ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
            <Label Grid.Column="0" Text="Finance" Style="{StaticResource H1}"
                   VerticalOptions="Center" />
            <Border Grid.Column="1"
                    BackgroundColor="{StaticResource CreamSoft}"
                    Stroke="{StaticResource Wine}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 10"
                    Padding="10,6"
                    HorizontalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnRefreshTapped" />
                </Border.GestureRecognizers>
                <Label Text="↻"
                       FontSize="22" FontAttributes="Bold"
                       TextColor="{StaticResource Wine}"
                       VerticalOptions="Center"
                       HorizontalOptions="Center" />
            </Border>
        </Grid>

        <!-- Pricing (today's active price rules) + coverage-gap warning -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,0" Spacing="2">
            <Label Text="{Binding PricingSummary}"
                   Style="{StaticResource Caption}" />
            <Label Text="{Binding PricingWarning}"
                   IsVisible="{Binding HasPricingWarning}"
                   TextColor="{StaticResource DangerRed}"
                   FontAttributes="Bold" />
        </VerticalStackLayout>

        <!-- Tab buttons (instructor-only; member sees only the Monthly carousel page) -->
        <Grid Grid.Row="2" Padding="16,8" ColumnDefinitions="*,*,*,*" ColumnSpacing="6"
              IsVisible="{Binding IsLoggedInInstructor}">
            <Button Grid.Column="0" Text="Monthly"
                    Command="{Binding ShowMonthlyTabCommand}"
                    BackgroundColor="{StaticResource CreamSoft}"
                    TextColor="{StaticResource Wine}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsMonthlyTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Wine}" />
                        <Setter Property="TextColor" Value="{StaticResource Cream}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="1" Text="Yearly"
                    Command="{Binding ShowYearlyTabCommand}"
                    BackgroundColor="{StaticResource CreamSoft}"
                    TextColor="{StaticResource Wine}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsYearlyTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Wine}" />
                        <Setter Property="TextColor" Value="{StaticResource Cream}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="2" Text="All Time"
                    Command="{Binding ShowAllTimeTabCommand}"
                    BackgroundColor="{StaticResource CreamSoft}"
                    TextColor="{StaticResource Wine}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsAllTimeTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Wine}" />
                        <Setter Property="TextColor" Value="{StaticResource Cream}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
            <Button Grid.Column="3" Text="Prices"
                    Command="{Binding ShowPricesTabCommand}"
                    BackgroundColor="{StaticResource CreamSoft}"
                    TextColor="{StaticResource Wine}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPricesTab}" Value="True">
                        <Setter Property="BackgroundColor" Value="{StaticResource Wine}" />
                        <Setter Property="TextColor" Value="{StaticResource Cream}" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Swipeable tab content -->
        <CarouselView Grid.Row="3"
                      ItemsSource="{Binding Tabs}"
                      Position="{Binding SelectedTabIndex, Mode=TwoWay}"
                      Loop="False"
                      IsSwipeEnabled="True"
                      ItemTemplate="{StaticResource TabSelector}"
                      IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}" />

        <!-- Loading overlay -->
        <VerticalStackLayout Grid.RowSpan="4"
                             HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                             InputTransparent="False"
                             IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               WidthRequest="48" HeightRequest="48" />
            <Label Text="Loading..." TextColor="{StaticResource Wine}" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>