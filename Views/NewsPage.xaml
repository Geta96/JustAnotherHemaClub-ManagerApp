<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels;assembly=JustAnotherHemaClub.Core"
             x:Class="JustAnotherHemaClub.Views.NewsPage"
             x:DataType="vm:NewsViewModel"
             Title="News">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Title + refresh -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                <Label Grid.Column="0" Text="News" Style="{StaticResource H1}" VerticalOptions="Center" />
                <Label Grid.Column="1" Style="{StaticResource RefreshIcon}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRefreshTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Instructor: create news card -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsInstructor}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Create news" Style="{StaticResource H2}" />

                    <Label Text="Title" Style="{StaticResource Caption}" />
                    <Entry Placeholder="News title" Text="{Binding NewTitle}" />

                    <Label Text="Body" Style="{StaticResource Caption}" />
                    <Editor Placeholder="Write announcement..."
                            AutoSize="TextChanges"
                            MinimumHeightRequest="80"
                            Text="{Binding NewBody}" />

                    <Button Text="Publish"
                            BackgroundColor="#476FB5"
                            TextColor="{StaticResource Cream}"
                            Command="{Binding CreateNewsCommand}" />

                    <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               HorizontalOptions="Center" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoNews}">
                <Label Text="No news yet." Style="{StaticResource Caption}" />
            </Border>

            <VerticalStackLayout BindableLayout.ItemsSource="{Binding News}" Spacing="12">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:NewsRow">
                        <Border Style="{StaticResource Card}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding Title}"
                                           Style="{StaticResource H2}"
                                           FontSize="17"
                                           LineBreakMode="WordWrap" />
                                    <Label Grid.Column="1"
                                           Text="{Binding DateText}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Start" />
                                </Grid>

                                <Label Text="{Binding Body}"
                                       LineHeight="1.3"
                                       LineBreakMode="WordWrap" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Grid.Column="0"
                                           Text="{Binding AuthorName, StringFormat='Posted by {0}'}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="Delete"
                                            BackgroundColor="{StaticResource DangerRed}"
                                            TextColor="{StaticResource Cream}"
                                            HeightRequest="36"
                                            Padding="12,0"
                                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:NewsViewModel}}, Path=IsInstructor}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:NewsViewModel}}, Path=DeleteNewsCommand}"
                                            CommandParameter="{Binding .}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
