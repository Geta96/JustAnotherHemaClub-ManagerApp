<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels;assembly=JustAnotherHemaClub.Core"
             x:Class="JustAnotherHemaClub.Views.ProfilePage"
             x:DataType="vm:ProfileViewModel"
             Title="My Profile">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Guest banner -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsGuest}">
                <VerticalStackLayout Spacing="6">
                    <Label Text="You are browsing as a guest"
                           Style="{StaticResource H2}" />
                    <Label Text="Log in to view and edit your fencer profile."
                           Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Status / error banner (shared across all the instant-save actions below) -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding HasStatusMessage}">
                <Label Text="{Binding StatusMessage}" Style="{StaticResource Caption}" />
            </Border>

            <!-- Read-only identity card -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoggedInFencer}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Account" Style="{StaticResource H2}" />

                    <Label Text="Full name" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Name}" FontAttributes="Bold" />

                    <Label Text="Username" Style="{StaticResource Caption}" />
                    <HorizontalStackLayout Spacing="0">
                        <Label Text="@" FontAttributes="Bold" />
                        <Label Text="{Binding Username}" FontAttributes="Bold" />
                    </HorizontalStackLayout>

                    <Label Text="Email" Style="{StaticResource Caption}" />
                    <Label Text="{Binding Email}" FontAttributes="Bold" />

                    <HorizontalStackLayout Spacing="8" Padding="0,8,0,0">
                        <Border BackgroundColor="#1F8A2E"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding IsActive}">
                            <Label Text="Active" TextColor="White"
                                   FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Slate}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding IsStudent}">
                            <Label Text="Student · 60%" TextColor="White"
                                   FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Wine}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding IsInstructor}">
                            <Label Text="Instructor" TextColor="White"
                                   FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>

                    <Button Text="Open HEMA Ratings profile"
                            Margin="0,8,0,0"
                            BackgroundColor="{StaticResource HemaRatingsBg}"
                            TextColor="{StaticResource HemaRatingsText}"
                            IsEnabled="{Binding HasSavedHemaRatingsLink}"
                            Clicked="OnOpenHemaRatingsTapped" />
                </VerticalStackLayout>
            </Border>

            <!-- Statements (expanded by default): GDPR + liability.
                 Checkboxes save immediately on toggle — no shared Save button. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoggedInFencer}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleStatementsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="{Binding StatementsExpandGlyph}"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Statements" Style="{StaticResource H2}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsStatementsExpanded}" Spacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.3" Margin="0,2" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding GdprAccepted}" />
                            <Label   Grid.Column="1" VerticalOptions="Center"
                                     LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I have read and agree to the " />
                                        <Span Text="GDPR statement"
                                              TextColor="{StaticResource Wine}"
                                              TextDecorations="Underline"
                                              FontAttributes="Bold">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnOpenGdprTapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding LiabilityAccepted}" />
                            <Label   Grid.Column="1" VerticalOptions="Center"
                                     LineBreakMode="WordWrap">
                                <Label.FormattedText>
                                    <FormattedString>
                                        <Span Text="I have read and agree to the " />
                                        <Span Text="liability statement"
                                              TextColor="{StaticResource Wine}"
                                              TextDecorations="Underline"
                                              FontAttributes="Bold">
                                            <Span.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnOpenLiabilityTapped" />
                                            </Span.GestureRecognizers>
                                        </Span>
                                        <Span Text="." />
                                    </FormattedString>
                                </Label.FormattedText>
                            </Label>
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Settings (expanded by default): user settings (incl. full name) + app settings.
                 The student / notification checkboxes save immediately; the name field has its
                 own explicit Save button, placed right next to the input. -->
            <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoggedInFencer}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleSettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Grid.Column="0"
                               Text="{Binding SettingsExpandGlyph}"
                               FontSize="20" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Settings" Style="{StaticResource H2}"
                               VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout IsVisible="{Binding IsSettingsExpanded}" Spacing="10">
                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.3" Margin="0,2" />

                        <!-- User settings -->
                        <Label Text="User settings" Style="{StaticResource Caption}" FontAttributes="Bold" />

                        <Label Text="Full name" Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry Grid.Column="0" Placeholder="Full name" Text="{Binding Name}" />
                            <Button Grid.Column="1" Text="Save" Command="{Binding SaveNameCommand}" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding IsStudent}" />
                            <Label   Grid.Column="1" VerticalOptions="Center"
                                     Text="I am a student (pays 60% of every fee)." />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.3" Margin="0,4" />

                        <!-- HEMA Ratings profile link -->
                        <Label Text="HEMA Ratings profile" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Label Text="Paste your HEMA Ratings fighter id."
                               Style="{StaticResource Caption}" />
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                            <Label Grid.Column="0" Text="hemaratings.com/fighters/details/"
                                   VerticalOptions="Center" FontSize="12"
                                   TextColor="{StaticResource Muted}" />
                            <Entry Grid.Column="1" Placeholder="0000" Keyboard="Numeric"
                                   Text="{Binding HemaRatingsId}" />
                            <Button Grid.Column="2" Text="Save"
                                    Command="{Binding SaveHemaRatingsCommand}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.3" Margin="0,4" />

                        <!-- App settings -->
                        <Label Text="App settings" Style="{StaticResource Caption}" FontAttributes="Bold" />
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <CheckBox Grid.Column="0" IsChecked="{Binding NotificationsEnabled}" />
                            <Label   Grid.Column="1" VerticalOptions="Center"
                                     Text="Enable normal notifications" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"
                              IsVisible="{Binding IsInstructor}">
                            <CheckBox Grid.Column="0" IsChecked="{Binding InstructorNotificationsEnabled}" />
                            <Label   Grid.Column="1" VerticalOptions="Center"
                                     Text="Enable instructor notifications" />
                        </Grid>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>