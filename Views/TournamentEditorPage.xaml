<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.TournamentEditorPage"
             x:Name="EditorPage"
             x:DataType="vm:TournamentEditorVm"
             Title="Tournament">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Header / details -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tournament details" Style="{StaticResource H2}" />

                    <Label Text="Name" Style="{StaticResource Caption}" />
                    <Entry Placeholder="Tournament name" Text="{Binding Name}" />

                    <Label Text="Organiser password" Style="{StaticResource Caption}" />
                    <Entry Placeholder="Required to edit"
                           IsPassword="True"
                           Text="{Binding Password}" />

                    <Label Style="{StaticResource Caption}"
                           IsVisible="{Binding IsExisting}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Status: " FontAttributes="Bold" />
                                <Span Text="{Binding Tournament.State}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="Changes save automatically."
                           Style="{StaticResource Caption}"
                           IsVisible="{Binding IsExisting}" />
                </VerticalStackLayout>
            </Border>

            <!-- Roster -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Roster" Style="{StaticResource H2}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding FencerCountText}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Add fencer (Setup only) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding CanAddFencers}">
                        <Entry Grid.Column="0"
                               Placeholder="Fencer name"
                               Text="{Binding NewFencerName}"
                               ReturnCommand="{Binding AddFencerCommand}" />
                        <Button Grid.Column="1" Text="Add"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                Command="{Binding AddFencerCommand}" />
                    </Grid>

                    <Label Text="Roster is locked once the tournament starts. Use Withdraw to remove a fencer mid-tournament — their remaining matches become walkovers."
                           Style="{StaticResource Caption}"
                           IsVisible="{Binding ShowLiveWithdrawHint}" />

                    <!-- Fencer list -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fencers}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TournamentFencerRow">
                                <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="10,6"
                                        BackgroundColor="{StaticResource CreamSoft}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Wine}" />
                                            <Label Text="{Binding StatusText}"
                                                   Style="{StaticResource Caption}"
                                                   TextColor="{StaticResource DangerRed}"
                                                   IsVisible="{Binding IsWithdrawn}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="{Binding WithdrawButtonText}"
                                                HeightRequest="34" Padding="10,0"
                                                BackgroundColor="{StaticResource Wine}"
                                                TextColor="{StaticResource Cream}"
                                                IsVisible="{Binding Source={x:Reference EditorPage}, Path=BindingContext.IsExisting}"
                                                Clicked="OnWithdrawFencerClicked" />
                                        <Button Grid.Column="2"
                                                Text="&#x2715;"
                                                HeightRequest="34" WidthRequest="40"
                                                BackgroundColor="{StaticResource DangerRed}"
                                                TextColor="{StaticResource Cream}"
                                                IsVisible="{Binding Source={x:Reference EditorPage}, Path=BindingContext.CanRemoveFencers}"
                                                Command="{Binding Source={x:Reference EditorPage}, Path=BindingContext.RemoveFencerCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Button Text="Create Tournament"
                    BackgroundColor="#476FB5"
                    TextColor="{StaticResource Cream}"
                    IsVisible="{Binding IsNew}"
                    Clicked="OnCreateTournamentClicked" />

            <!-- Pool allocation (Setup only) -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding ShowPoolAllocation}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Pool allocation" Style="{StaticResource H2}" />
                    <Label Text="Place fencers into pools before starting. Auto-distribute fills empty pools with the active roster; tap a fencer to move them to another pool."
                           Style="{StaticResource Caption}" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <Button Grid.Column="0" Text="Auto-distrib"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                FontSize="12"
                                Padding="4,0"
                                Command="{Binding AutoDistributePoolsCommand}" />
                        <Button Grid.Column="1" Text="+ Pool"
                                BackgroundColor="{StaticResource Wine}"
                                TextColor="{StaticResource Cream}"
                                FontSize="12"
                                Padding="4,0"
                                Command="{Binding AddPoolCommand}" />
                        <Button Grid.Column="2" Text="Reset"
                                BackgroundColor="{StaticResource CreamSoft}"
                                TextColor="{StaticResource DangerRed}"
                                BorderColor="{StaticResource DangerRed}"
                                BorderWidth="1"
                                FontSize="12"
                                Padding="4,0"
                                Command="{Binding UnassignAllFencersCommand}" />
                    </Grid>

                    <!-- Unassigned fencers -->
                    <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 6"
                            BackgroundColor="{StaticResource CreamSoft}"
                            Padding="10,8"
                            IsVisible="{Binding HasUnassignedFencers}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Unassigned"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource DangerRed}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding UnassignedFencers}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:EditorPoolFencerVm">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <Label Grid.Column="0" Text="{Binding Name}"
                                                   TextColor="{StaticResource Wine}"
                                                   VerticalOptions="Center" />
                                            <Button Grid.Column="1" Text="Assign…"
                                                    HeightRequest="34" Padding="10,0"
                                                    BackgroundColor="#476FB5"
                                                    TextColor="{StaticResource Cream}"
                                                    Clicked="OnAssignFencerClicked" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Per-pool draft cards -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding DraftPools}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:EditorPoolVm">
                                <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="{StaticResource CreamSoft}"
                                        Padding="10,8">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                            <VerticalStackLayout Grid.Column="0" Spacing="0">
                                                <Label Text="{Binding Title}"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Wine}" />
                                                <Label Text="{Binding CountText}"
                                                       Style="{StaticResource Caption}" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" Text="− Pool"
                                                    HeightRequest="34" Padding="10,0"
                                                    BackgroundColor="{StaticResource DangerRed}"
                                                    TextColor="{StaticResource Cream}"
                                                    IsVisible="{Binding IsEmpty}"
                                                    Command="{Binding Source={x:Reference EditorPage}, Path=BindingContext.RemovePoolCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Members}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:EditorPoolFencerVm">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Grid.Column="0" Text="{Binding Name}"
                                                               TextColor="{StaticResource Wine}"
                                                               VerticalOptions="Center" />
                                                        <Button Grid.Column="1" Text="Move…"
                                                                HeightRequest="32" Padding="10,0"
                                                                BackgroundColor="{StaticResource Wine}"
                                                                TextColor="{StaticResource Cream}"
                                                                Clicked="OnMoveFencerClicked" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Error banner: sits right above the Start card so messages from
                 Start Tournament (and every other action) are visible without
                 scrolling back to the top of the page. -->
            <Border BackgroundColor="#FFE2E2"
                    Stroke="{StaticResource DangerRed}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=False}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource DangerRed}" />
            </Border>

            <!-- Start -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding CanStart}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Start tournament" Style="{StaticResource H2}" />
                    <Label Text="{Binding StartHintText}" Style="{StaticResource Caption}" />
                    <Button Text="Start Tournament"
                            BackgroundColor="#1F8A2E"
                            TextColor="{StaticResource Cream}"
                            Clicked="OnStartTournamentClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Restart (after tournament has started) -->
            <Button Text="Restart Tournament"
                    BackgroundColor="#B8860B"
                    TextColor="{StaticResource Cream}"
                    IsVisible="{Binding CanRestart}"
                    Clicked="OnRestartClicked" />

            <!-- Delete -->
            <Button Text="Delete Tournament"
                    BackgroundColor="{StaticResource DangerRed}"
                    TextColor="{StaticResource Cream}"
                    IsVisible="{Binding IsExisting}"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>