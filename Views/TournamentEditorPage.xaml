<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.TournamentEditorPage"
             x:DataType="vm:TournamentEditorVm"
             Title="Tournament">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- Error banner -->
            <Border BackgroundColor="#FFE2E2"
                    Stroke="{StaticResource DangerRed}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}, FallbackValue=False}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="{StaticResource DangerRed}" />
            </Border>

            <!-- Header / details -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Tournament details" Style="{StaticResource H2}" />

                    <Label Text="Name" Style="{StaticResource Caption}" />
                    <Entry Placeholder="Tournament name" Text="{Binding Name}" />

                    <Label Text="Organiser password" Style="{StaticResource Caption}" />
                    <Entry Placeholder="Required to edit"
                           IsPassword="True"
                           Text="{Binding Password}" />

                    <Label Style="{StaticResource Caption}"
                           IsVisible="{Binding IsExisting}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Status: " FontAttributes="Bold" />
                                <Span Text="{Binding Tournament.State}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>

                    <Label Text="Changes save automatically."
                           Style="{StaticResource Caption}"
                           IsVisible="{Binding IsExisting}" />
                </VerticalStackLayout>
            </Border>

            <!-- Initial save (new only) -->
            <Button Text="Save Tournament"
                    BackgroundColor="#476FB5"
                    TextColor="{StaticResource Cream}"
                    Command="{Binding SaveNewCommand}"
                    IsVisible="{Binding IsNew}" />

            <!-- Roster -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Roster" Style="{StaticResource H2}"
                               VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="{Binding FencerCountText}"
                               Style="{StaticResource Caption}"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Add fencer (Setup only) -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsVisible="{Binding CanAddFencers}">
                        <Entry Grid.Column="0"
                               Placeholder="Fencer name"
                               Text="{Binding NewFencerName}"
                               ReturnCommand="{Binding AddFencerCommand}" />
                        <Button Grid.Column="1" Text="Add"
                                BackgroundColor="#476FB5"
                                TextColor="{StaticResource Cream}"
                                Command="{Binding AddFencerCommand}" />
                    </Grid>

                    <Label Text="Roster is locked once the tournament starts."
                           Style="{StaticResource Caption}"
                           IsVisible="{Binding IsSetupState, Converter={StaticResource InverseBoolConverter}}" />

                    <!-- Fencer list -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Fencers}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:TournamentFencerRow">
                                <Border Stroke="{StaticResource Wine}" StrokeThickness="1"
                                        StrokeShape="RoundRectangle 6"
                                        Padding="10,6"
                                        BackgroundColor="{StaticResource CreamSoft}">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="0">
                                            <Label Text="{Binding Name}"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Wine}" />
                                            <Label Text="{Binding StatusText}"
                                                   Style="{StaticResource Caption}"
                                                   TextColor="{StaticResource DangerRed}"
                                                   IsVisible="{Binding IsWithdrawn}" />
                                        </VerticalStackLayout>
                                        <Button Grid.Column="1"
                                                Text="{Binding WithdrawButtonText}"
                                                HeightRequest="34" Padding="10,0"
                                                BackgroundColor="{StaticResource Wine}"
                                                TextColor="{StaticResource Cream}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentEditorVm}}, Path=IsExisting}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentEditorVm}}, Path=WithdrawFencerCommand}"
                                                CommandParameter="{Binding .}" />
                                        <Button Grid.Column="2"
                                                Text="&#x2715;"
                                                HeightRequest="34" WidthRequest="40"
                                                BackgroundColor="{StaticResource DangerRed}"
                                                TextColor="{StaticResource Cream}"
                                                IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentEditorVm}}, Path=CanRemoveFencers}"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:TournamentEditorVm}}, Path=RemoveFencerCommand}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Start -->
            <Border Style="{StaticResource Card}"
                    IsVisible="{Binding IsExisting}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Start tournament" Style="{StaticResource H2}"
                           IsVisible="{Binding IsSetupState}" />
                    <Label Text="{Binding StartHintText}" Style="{StaticResource Caption}"
                           IsVisible="{Binding IsSetupState}" />
                    <Button Text="Start Tournament"
                            BackgroundColor="#1F8A2E"
                            TextColor="{StaticResource Cream}"
                            IsVisible="{Binding IsSetupState}"
                            Clicked="OnStartTournamentClicked" />
                </VerticalStackLayout>
            </Border>

            <!-- Delete -->
            <Button Text="Delete Tournament"
                    BackgroundColor="{StaticResource DangerRed}"
                    TextColor="{StaticResource Cream}"
                    IsVisible="{Binding IsExisting}"
                    Clicked="OnDeleteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>