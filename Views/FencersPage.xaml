<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:m="clr-namespace:JustAnotherHemaClub.Models"
             x:Class="JustAnotherHemaClub.Views.FencersPage"
             x:DataType="vm:FencersViewModel"
             Title="Fencers">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Fencer profiles" Style="{StaticResource H1}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource CreamSoft}"
                            Stroke="{StaticResource Wine}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,6"
                            HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="↻"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <VerticalStackLayout Spacing="14"
                                     IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">
                    <!-- Picker -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Select a fencer" Style="{StaticResource H2}" />
                            <Picker Title="Pick a fencer..."
                                    ItemsSource="{Binding Fencers}"
                                    ItemDisplayBinding="{Binding Name}"
                                    SelectedItem="{Binding SelectedFencer, Mode=TwoWay}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- HERO PROFILE CARD -->
                    <Border IsVisible="{Binding HasSelection}"
                            BackgroundColor="{StaticResource Surface}"
                            Stroke="{StaticResource Wine}" StrokeThickness="2"
                            StrokeShape="RoundRectangle 14"
                            Padding="0">
                        <VerticalStackLayout BindingContext="{Binding SelectedDetails}"
                                             x:DataType="vm:FencerDetailsVm" Spacing="14">

                            <!-- Wine header strip: avatar + name + handle -->
                            <Grid BackgroundColor="{StaticResource Wine}" Padding="16,14"
                                  ColumnDefinitions="Auto,*" ColumnSpacing="14">

                                <Border Grid.Column="0"
                                        BackgroundColor="{StaticResource Cream}"
                                        StrokeShape="RoundRectangle 28"
                                        StrokeThickness="0"
                                        WidthRequest="56" HeightRequest="56"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Initials}"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="{StaticResource Wine}"
                                           HorizontalOptions="Center" VerticalOptions="Center"
                                           LineBreakMode="NoWrap" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Name}"
                                           FontSize="22" FontAttributes="Bold"
                                           TextColor="{StaticResource Cream}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Username, StringFormat='@{0}'}"
                                           TextColor="{StaticResource Cream}" Opacity="0.8"
                                           FontAttributes="Italic"
                                           IsVisible="{Binding HasUsername}" />
                                </VerticalStackLayout>
                            </Grid>

                            <!-- Role chips -->
                            <HorizontalStackLayout Padding="16,0,16,0" Spacing="8">
                                <Border BackgroundColor="#1F8A2E"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        Padding="10,4"
                                        IsVisible="{Binding Active}">
                                    <Label Text="Active" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="{StaticResource Slate}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        Padding="10,4"
                                        IsVisible="{Binding IsStudent}">
                                    <Label Text="Student · 60%" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </Border>
                                <Border BackgroundColor="{StaticResource Wine}"
                                        StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                        Padding="10,4"
                                        IsVisible="{Binding Fencer.IsInstructor}">
                                    <Label Text="Instructor" TextColor="White" FontSize="12" FontAttributes="Bold" />
                                </Border>
                            </HorizontalStackLayout>

                            <!-- Instructor-only detail block -->
                            <Border Margin="16,0,16,0"
                                    BackgroundColor="{StaticResource CreamSoft}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    Padding="14"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FencersViewModel}}, Path=IsLoggedInInstructor}">
                                <Grid ColumnDefinitions="110,*" RowSpacing="10" ColumnSpacing="10">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Row="0" Grid.Column="0" Text="Email" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email}" FontAttributes="Bold"
                                           VerticalOptions="Center" LineBreakMode="TailTruncation" />

                                    <Label Grid.Row="1" Grid.Column="0" Text="Username" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding Username}"
                                           VerticalOptions="Center" />

                                    <Label Grid.Row="2" Grid.Column="0" Text="GDPR" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto" VerticalOptions="Center">
                                        <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                               TextColor="#1F8A2E"
                                               IsVisible="{Binding GdprAccepted}" />
                                        <Label Text="✗" FontSize="20" FontAttributes="Bold"
                                               TextColor="{StaticResource DangerRed}"
                                               IsVisible="False">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding GdprAccepted}"
                                                             Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <Label Grid.Row="3" Grid.Column="0" Text="Liability" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto" VerticalOptions="Center">
                                        <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                               TextColor="#1F8A2E"
                                               IsVisible="{Binding LiabilityAccepted}" />
                                        <Label Text="✗" FontSize="20" FontAttributes="Bold"
                                               TextColor="{StaticResource DangerRed}"
                                               IsVisible="False">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label"
                                                             Binding="{Binding LiabilityAccepted}"
                                                             Value="False">
                                                    <Setter Property="IsVisible" Value="True" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>

                                    <Label Grid.Row="4" Grid.Column="0" Text="Payment" Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <HorizontalStackLayout Grid.Row="4" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                        <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                               TextColor="#1F8A2E"
                                               IsVisible="{Binding IsPaid}"
                                               VerticalOptions="Center" />
                                        <Label Text="{Binding AmountDue, StringFormat='Owes {0:N0} Ft'}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource DangerRed}"
                                               IsVisible="{Binding OwesMoney}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </Border>

                            <!-- Activity -->
                            <Border Margin="16,0,16,0"
                                    BackgroundColor="{StaticResource CreamSoft}"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    Padding="14">
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="Activity" Style="{StaticResource H2}" />

                                    <!-- 4-line stat grid (label / value), all vertically centred -->
                                    <Grid ColumnDefinitions="150,*" RowSpacing="8" ColumnSpacing="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Label Grid.Row="0" Grid.Column="0" Text="Average attendance"
                                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Label Grid.Row="0" Grid.Column="1" Text="{Binding AverageAttendanceText}"
                                               FontAttributes="Bold" VerticalOptions="Center" />

                                        <Label Grid.Row="1" Grid.Column="0" Text="Most in one month"
                                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Label Grid.Row="1" Grid.Column="1" Text="{Binding MostAttendanceText}"
                                               FontAttributes="Bold" VerticalOptions="Center" />

                                        <Label Grid.Row="2" Grid.Column="0" Text="1 on 1 received"
                                               Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        <Label Grid.Row="2" Grid.Column="1" Text="{Binding OneOnOneReceived}"
                                               FontAttributes="Bold" VerticalOptions="Center" />

                                        <Label Grid.Row="3" Grid.Column="0" Text="1 on 1 given"
                                               Style="{StaticResource Caption}" VerticalOptions="Center"
                                               IsVisible="{Binding ShowOneOnOneGiven}" />
                                        <Label Grid.Row="3" Grid.Column="1" Text="{Binding OneOnOneGiven}"
                                               FontAttributes="Bold" VerticalOptions="Center"
                                               IsVisible="{Binding ShowOneOnOneGiven}" />
                                    </Grid>

                                    <!-- Active months -->
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Active months" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding ActiveMonthsText}" />
                                    </VerticalStackLayout>

                                    <!-- Recent trainings -->
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Recent trainings" Style="{StaticResource Caption}" />

                                        <Label Text="No trainings attended yet."
                                               Style="{StaticResource Caption}"
                                               IsVisible="{Binding HasRecentSessions, Converter={StaticResource InverseBoolConverter}}" />

                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding RecentSessions}" Spacing="4">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FencerSessionRow">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding DateText}"
                                                               FontAttributes="Bold"
                                                               TextColor="{StaticResource Wine}"
                                                               VerticalOptions="Center"
                                                               LineBreakMode="NoWrap" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Topic}"
                                                               LineBreakMode="TailTruncation"
                                                               VerticalOptions="Center" />
                                                    </Grid>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Promote action -->
                            <Button Text="Promote to instructor"
                                    Margin="16,0,16,16"
                                    Style="{StaticResource SecondaryButton}"
                                    Clicked="OnPromoteClicked"
                                    IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FencersViewModel}}, Path=CanPromoteSelected}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Screen-centred overlay -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                             InputTransparent="False"
                             IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               WidthRequest="48" HeightRequest="48" />
            <Label Text="Loading..." TextColor="{StaticResource Wine}" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>