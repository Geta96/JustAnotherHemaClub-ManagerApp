<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:m="clr-namespace:JustAnotherHemaClub.Models"
             x:Class="JustAnotherHemaClub.Views.FencersPage"
             x:DataType="vm:FencersViewModel"
             Title="Fencers">
    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Label Text="Fencer profiles" Style="{StaticResource H1}" />

            <!-- Picker -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Select a fencer" Style="{StaticResource H2}" />
                    <Picker Title="Pick a fencer..."
                            ItemsSource="{Binding Fencers}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedFencer, Mode=TwoWay}" />
                </VerticalStackLayout>
            </Border>

            <!-- HERO PROFILE CARD -->
            <Border IsVisible="{Binding HasSelection}"
                    BackgroundColor="{StaticResource Surface}"
                    Stroke="{StaticResource Wine}" StrokeThickness="2"
                    StrokeShape="RoundRectangle 14"
                    Padding="0">
                <VerticalStackLayout BindingContext="{Binding SelectedDetails}"
                                     x:DataType="vm:FencerDetailsVm" Spacing="0">

                    <Grid BackgroundColor="{StaticResource Wine}" Padding="16,14"
                          ColumnDefinitions="Auto,*" ColumnSpacing="14">

                        <Border Grid.Column="0"
                                BackgroundColor="{StaticResource Cream}"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                WidthRequest="56" HeightRequest="56"
                                VerticalOptions="Center">
                            <Label Text="{Binding Name}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Wine}"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding Name}"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource Cream}" />
                            <Label Text="{Binding Username, StringFormat='@{0}'}"
                                   TextColor="{StaticResource Cream}" Opacity="0.8"
                                   FontAttributes="Italic"
                                   IsVisible="{Binding HasUsername}" />
                        </VerticalStackLayout>
                    </Grid>

                    <HorizontalStackLayout Padding="16,12,16,0" Spacing="8">
                        <Border BackgroundColor="#1F8A2E"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding Active}">
                            <Label Text="Active" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Slate}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding IsStudent}">
                            <Label Text="Student · 60%" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="{StaticResource Wine}"
                                StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                Padding="10,4"
                                IsVisible="{Binding Fencer.IsInstructor}">
                            <Label Text="Instructor" TextColor="White" FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>

                    <Border Margin="16,12,16,16"
                            BackgroundColor="{StaticResource CreamSoft}"
                            StrokeThickness="0" StrokeShape="RoundRectangle 10"
                            Padding="14">
                        <Grid ColumnDefinitions="110,*" RowSpacing="10" ColumnSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label Grid.Row="0" Grid.Column="0" Text="Email" Style="{StaticResource Caption}" />
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Email}" FontAttributes="Bold" />

                            <Label Grid.Row="1" Grid.Column="0" Text="Username" Style="{StaticResource Caption}" />
                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding Username}" />

                            <Label Grid.Row="2" Grid.Column="0" Text="GDPR" Style="{StaticResource Caption}" />
                            <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="Auto">
                                <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                       TextColor="#1F8A2E"
                                       IsVisible="{Binding GdprAccepted}" />
                                <Label Text="✗" FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource DangerRed}"
                                       IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding GdprAccepted}"
                                                     Value="False">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Grid.Row="3" Grid.Column="0" Text="Liability" Style="{StaticResource Caption}" />
                            <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="Auto">
                                <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                       TextColor="#1F8A2E"
                                       IsVisible="{Binding LiabilityAccepted}" />
                                <Label Text="✗" FontSize="20" FontAttributes="Bold"
                                       TextColor="{StaticResource DangerRed}"
                                       IsVisible="False">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding LiabilityAccepted}"
                                                     Value="False">
                                            <Setter Property="IsVisible" Value="True" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </Grid>

                            <Label Grid.Row="4" Grid.Column="0" Text="Payment" Style="{StaticResource Caption}" />
                            <HorizontalStackLayout Grid.Row="4" Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <Label Text="✓" FontSize="20" FontAttributes="Bold"
                                       TextColor="#1F8A2E"
                                       IsVisible="{Binding IsPaid}"
                                       VerticalOptions="Center" />
                                <Label Text="{Binding AmountDue, StringFormat='Owes {0:N0} Ft'}"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource DangerRed}"
                                       IsVisible="{Binding OwesMoney}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>

                    <Button Text="Promote to instructor"
                            Margin="16,0,16,16"
                            Style="{StaticResource SecondaryButton}"
                            Clicked="OnPromoteClicked"
                            IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:FencersViewModel}}, Path=CanPromoteSelected}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.4" Margin="0,10,0,0" />
            <VerticalStackLayout Spacing="2" Padding="0,4,0,0">
                <Label Text="Club-wide compliance" Style="{StaticResource H1}"
                       TextColor="{StaticResource Wine}" />
                <Label Text="These cards summarise all active fencers — not just the selected one."
                       Style="{StaticResource Caption}" />
            </VerticalStackLayout>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="GDPR consent" Style="{StaticResource H2}" />
                        <Label Grid.Column="1" Text="✓ OK"
                               IsVisible="{Binding AllGdprOk}"
                               TextColor="#1F8A2E" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding GdprSummary}" Style="{StaticResource Caption}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MissingGdpr}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:Fencer">
                                <Label Text="{Binding Name}"
                                       TextColor="{StaticResource DangerRed}"
                                       FontAttributes="Bold" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="Liability statement" Style="{StaticResource H2}" />
                        <Label Grid.Column="1" Text="✓ OK"
                               IsVisible="{Binding AllLiabilityOk}"
                               TextColor="#1F8A2E" FontAttributes="Bold" VerticalOptions="Center" />
                    </Grid>
                    <Label Text="{Binding LiabilitySummary}" Style="{StaticResource Caption}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding MissingLiability}" Spacing="4">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="m:Fencer">
                                <Label Text="{Binding Name}"
                                       TextColor="{StaticResource DangerRed}"
                                       FontAttributes="Bold" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>