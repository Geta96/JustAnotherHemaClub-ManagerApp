<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             xmlns:m="clr-namespace:JustAnotherHemaClub.Models"
             x:Class="JustAnotherHemaClub.Views.StatisticsPage"
             x:DataType="vm:StatisticsViewModel"
             Title="Statistics">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Statistics" Style="{StaticResource H1}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Style="{StaticResource RefreshIcon}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshTapped" />
                        </Label.GestureRecognizers>
                    </Label>
                </Grid>

                <VerticalStackLayout Spacing="14"
                                     IsVisible="{Binding IsLoading, Converter={StaticResource InverseBoolConverter}}">

                    <!-- Per-month breakdown -->
                    <Label Text="Monthly breakdown" Style="{StaticResource H2}" />
                    <CollectionView ItemsSource="{Binding Months}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthStatRow">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10">
                                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                                               Text="{Binding Title}" FontAttributes="Bold"
                                               TextColor="{StaticResource Wine}" />
                                        <Label Grid.Row="1" Grid.Column="0"
                                               Text="{Binding Sessions, StringFormat='{0} sessions'}"
                                               Style="{StaticResource Caption}" />
                                        <Label Grid.Row="1" Grid.Column="1"
                                               Text="{Binding Income, StringFormat='In {0:N0}'}"
                                               TextColor="{StaticResource Slate}" />
                                        <Label Grid.Row="1" Grid.Column="2"
                                               Text="{Binding Expenses, StringFormat='Out {0:N0}'}"
                                               TextColor="{StaticResource Wine}" />
                                        <Label Grid.Row="1" Grid.Column="3"
                                               Text="{Binding Balance, StringFormat='= {0:N0}'}"
                                               FontAttributes="Bold" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Leaderboards -->
                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Best attendance — last 3 months" Style="{StaticResource H2}" />
                            <Label Text="{Binding RecentAttendanceSubtitle}" Style="{StaticResource Caption}" />
                            <Label Text="Top 5 - Instructors excluded" Style="{StaticResource Caption}" />

                            <Label Text="No attendance recorded in this window."
                                   Style="{StaticResource Caption}"
                                   IsVisible="{Binding TopAttendanceRecent.Count, Converter={StaticResource InverseBoolConverter}, FallbackValue=False}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopAttendanceRecent}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeaderboardRow">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding RankText}"
                                                   FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1" Text="{Binding Name}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding CountText}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Best attendance — all time" Style="{StaticResource H2}" />
                            <Label Text="Top 5 - Instructors excluded" Style="{StaticResource Caption}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopAttendanceAllTime}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeaderboardRow">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding RankText}"
                                                   FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1" Text="{Binding Name}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding CountText}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Most 1 on 1 lessons given" Style="{StaticResource H2}" />
                            <Label Text="Accepted lessons - Instructors only" Style="{StaticResource Caption}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopOneOnOneGivers}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeaderboardRow">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding RankText}"
                                                   FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1" Text="{Binding Name}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding CountText}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Most 1 on 1 lessons received" Style="{StaticResource H2}" />
                            <Label Text="Accepted lessons only" Style="{StaticResource Caption}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding TopOneOnOneReceivers}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LeaderboardRow">
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                                            <Label Grid.Column="0" Text="{Binding RankText}"
                                                   FontAttributes="Bold" TextColor="{StaticResource Wine}" />
                                            <Label Grid.Column="1" Text="{Binding Name}"
                                                   LineBreakMode="TailTruncation" />
                                            <Label Grid.Column="2" Text="{Binding CountText}"
                                                   FontAttributes="Bold" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Club-wide compliance (instructor only) -->
                    <BoxView HeightRequest="1" Color="{StaticResource Muted}" Opacity="0.4" Margin="0,10,0,0"
                             IsVisible="{Binding IsLoggedInInstructor}" />
                    <VerticalStackLayout Spacing="2" Padding="0,4,0,0"
                                         IsVisible="{Binding IsLoggedInInstructor}">
                        <Label Text="Club-wide compliance" Style="{StaticResource H1}"
                               TextColor="{StaticResource Wine}" />
                        <Label Text="These cards summarise all active fencers — not just the selected one."
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoggedInInstructor}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="GDPR consent" Style="{StaticResource H2}" />
                                <Label Grid.Column="1" Text="✓ OK"
                                       IsVisible="{Binding AllGdprOk}"
                                       TextColor="#1F8A2E" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding GdprSummary}" Style="{StaticResource Caption}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MissingGdpr}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:Fencer">
                                        <Label Text="{Binding Name}"
                                               TextColor="{StaticResource DangerRed}"
                                               FontAttributes="Bold" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border Style="{StaticResource Card}" IsVisible="{Binding IsLoggedInInstructor}">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Grid.Column="0" Text="Liability statement" Style="{StaticResource H2}" />
                                <Label Grid.Column="1" Text="✓ OK"
                                       IsVisible="{Binding AllLiabilityOk}"
                                       TextColor="#1F8A2E" FontAttributes="Bold" VerticalOptions="Center" />
                            </Grid>
                            <Label Text="{Binding LiabilitySummary}" Style="{StaticResource Caption}" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding MissingLiability}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="m:Fencer">
                                        <Label Text="{Binding Name}"
                                               TextColor="{StaticResource DangerRed}"
                                               FontAttributes="Bold" />
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- Screen-centred overlay -->
        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                             InputTransparent="False"
                             IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               WidthRequest="48" HeightRequest="48" />
            <Label Text="Loading..." TextColor="{StaticResource Wine}" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>