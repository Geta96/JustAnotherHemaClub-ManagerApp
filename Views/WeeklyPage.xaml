<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:JustAnotherHemaClub.ViewModels"
             x:Class="JustAnotherHemaClub.Views.WeeklyPage"
             x:DataType="vm:WeeklyViewModel"
             Title="Weekly">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="16" Spacing="14">

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label Grid.Column="0" Text="Weekly trainings" Style="{StaticResource H1}"
                           VerticalOptions="Center" />
                    <Border Grid.Column="1"
                            BackgroundColor="{StaticResource CreamSoft}"
                            Stroke="{StaticResource Wine}" StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,6"
                            HorizontalOptions="End">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRefreshTapped" />
                        </Border.GestureRecognizers>
                        <Label Text="↻"
                               FontSize="22" FontAttributes="Bold"
                               TextColor="{StaticResource Wine}"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
                    </Border>
                </Grid>

                <CollectionView ItemsSource="{Binding Rules}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:WeeklyRuleRow">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,10">
                                <VerticalStackLayout Spacing="8">

                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding DayName}"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Wine}"
                                               FontSize="18" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Summary}"
                                               Style="{StaticResource Caption}"
                                               VerticalOptions="Center" />
                                    </Grid>

                                    <!-- Instructor edit fields -->
                                    <VerticalStackLayout Spacing="6"
                                                         IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WeeklyViewModel}}, Path=IsLoggedInInstructor}">
                                        <Label Text="Topic" Style="{StaticResource Caption}" />
                                        <Entry Text="{Binding Topic}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <VerticalStackLayout Grid.Column="0" Spacing="4">
                                                <Label Text="Time" Style="{StaticResource Caption}" />
                                                <TimePicker Time="{Binding TimeOfDay}" />
                                            </VerticalStackLayout>
                                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="Starts on" Style="{StaticResource Caption}" />
                                                <DatePicker Date="{Binding StartDate}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                            <CheckBox IsChecked="{Binding HasEndDate}" />
                                            <Label Text="Has end date" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                        <DatePicker Date="{Binding EndDate}"
                                                    IsVisible="{Binding HasEndDate}" />

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                                            <Button Grid.Column="0" Text="Delete"
                                                    BackgroundColor="{StaticResource DangerRed}"
                                                    TextColor="{StaticResource Cream}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeeklyViewModel}}, Path=DeleteRuleCommand}"
                                                    CommandParameter="{Binding .}" />
                                            <Button Grid.Column="1" Text="Save changes"
                                                    BackgroundColor="#476FB5"
                                                    TextColor="{StaticResource Cream}"
                                                    IsVisible="{Binding IsDirty}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:WeeklyViewModel}}, Path=SaveRuleCommand}"
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </VerticalStackLayout>

                                    <!-- Always-visible topic line for everyone (instructors see editable Entry above instead) -->
                                    <Label Text="{Binding Topic, StringFormat='Topic: {0}'}"
                                           IsVisible="{Binding Source={RelativeSource AncestorType={x:Type vm:WeeklyViewModel}}, Path=IsNotLoggedInInstructor}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Button Text="Add Weekly Training"
                        BackgroundColor="#476FB5"
                        TextColor="{StaticResource Cream}"
                        IsVisible="{Binding IsLoggedInInstructor}"
                        Clicked="OnAddWeeklyTrainingClicked" />

                <VerticalStackLayout IsVisible="{Binding HasNoRules}">
                    <Label Text="No recurring trainings yet."
                           Style="{StaticResource Caption}"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8"
                             IsVisible="{Binding IsLoading}">
            <ActivityIndicator IsRunning="{Binding IsLoading}"
                               Color="{StaticResource Wine}"
                               WidthRequest="48" HeightRequest="48" />
            <Label Text="Loading..." TextColor="{StaticResource Wine}" FontAttributes="Bold" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>