@page "/forgot-password"
@layout LoginLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Reset password — JAHC Manager</PageTitle>

<div class="login-shell">
    <img src="images/monochrome_logo.jpg" alt="Just Another HEMA Club" class="login-crest" />

    <div class="login-card">
        @if (HasError)
        {
            <div class="login-error">@Error</div>
        }

        <p class="login-intro">
            Enter your username and the email on file, then choose a new password.
        </p>

        <form method="post" action="/auth/reset-password" class="login-form">
            <label class="login-label" for="username">Username</label>
            <input class="login-input" id="username" name="username" autocomplete="username" required />

            <label class="login-label" for="email">Email on file</label>
            <input class="login-input" id="email" name="email" type="email" autocomplete="email" required />

            <label class="login-label" for="newPassword">New password</label>
            <input class="login-input" id="newPassword" name="newPassword" type="password"
                   autocomplete="new-password" required />

            <label class="login-label" for="confirmPassword">Confirm new password</label>
            <input class="login-input" id="confirmPassword" name="confirmPassword" type="password"
                   autocomplete="new-password" required />

            <button class="login-button" type="submit">Set new password</button>
        </form>

        <div class="login-links">
            <a class="login-link" href="/login">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);
}