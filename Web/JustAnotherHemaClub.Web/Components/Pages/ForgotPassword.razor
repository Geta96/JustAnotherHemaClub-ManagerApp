@page "/forgot-password"
@layout LoginLayout
@using Microsoft.AspNetCore.Authorization
@attribute [AllowAnonymous]

<PageTitle>Reset password — JAHC Manager</PageTitle>

<div class="login-shell">
    <img src="images/monochrome_logo.jpg" alt="Just Another HEMA Club" class="login-crest" />

    <div class="login-card">
        @if (HasError)
        {
            <div class="login-error">@Error</div>
        }
        @if (Requested)
        {
            <div class="login-note">
                Request sent! Your new password will start working as soon as an
                instructor approves it. Nothing else is needed from you — just wait
                for an instructor to approve, then sign in with your new password.
            </div>
        }

        <p class="login-intro">
            Enter your username, the email on file, and choose a new password. An
            instructor must approve the change before your new password works.
        </p>

        <form method="post" action="/auth/forgot-password" class="login-form">
            <AntiforgeryToken />
            <label class="login-label" for="username">Username</label>
            <input class="login-input" id="username" name="username" autocomplete="username" required />

            <label class="login-label" for="email">Email on file</label>
            <input class="login-input" id="email" name="email" type="email" autocomplete="email" required />

            <label class="login-label" for="newPassword">New password</label>
            <input class="login-input" id="newPassword" name="newPassword" type="password"
                   autocomplete="new-password" required />

            <label class="login-label" for="confirmPassword">Confirm new password</label>
            <input class="login-input" id="confirmPassword" name="confirmPassword" type="password"
                   autocomplete="new-password" required />

            <button class="login-button" type="submit">Request new password</button>
        </form>

        <div class="login-links">
            <a class="login-link" href="/login">Back to sign in</a>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    [SupplyParameterFromQuery(Name = "requested")]
    private string? RequestedFlag { get; set; }

    private bool HasError => !string.IsNullOrEmpty(Error);
    private bool Requested => RequestedFlag == "1";
}