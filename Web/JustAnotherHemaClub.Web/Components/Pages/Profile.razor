@page "/profile"
@using Microsoft.AspNetCore.Authorization
@using JustAnotherHemaClub.Services
@attribute [Authorize]
@inject IGoogleSheetsService Sheets
@inject AuthService Auth
@inject UserSession Session

<PageTitle>My Profile — JAHC Manager</PageTitle>

<h1 class="page-title">My Profile</h1>

@if (Auth.IsGuest)
{
    <section class="card">
        <h2 class="card-title">You are browsing as a guest</h2>
        <p class="muted">Log in to view and edit your fencer profile.</p>
    </section>
}
else if (_fencer is { } f)
{
    @if (Saved == "main")
    {
        <section class="card"><p class="pay-ok">&#10003; Saved.</p></section>
    }
    @if (!string.IsNullOrEmpty(Error))
    {
        <section class="card"><p class="pay-due">@Error</p></section>
    }

    @* ---- Read-only identity card ---- *@
    <section class="card">
        <h2 class="card-title">Account</h2>
        <div class="kv"><span class="k">Full name</span><span class="v">@f.Name</span></div>
        <div class="kv"><span class="k">Username</span><span class="v">@@@f.Username</span></div>
        <div class="kv"><span class="k">Email</span><span class="v">@f.Email</span></div>

        <div class="chip-row" style="padding-left:0;">
            @if (f.Active)
            {
                <span class="chip chip-green">Active</span>
            }
            @if (f.IsStudent)
            {
                <span class="chip chip-slate">Student · 60%</span>
            }
            @if (f.IsInstructor)
            {
                <span class="chip chip-wine">Instructor</span>
            }
        </div>

        <div class="organiser-input-row" style="margin-top:12px;">
            <a class="hema-btn @(string.IsNullOrWhiteSpace(f.HemaRatingsId) ? "disabled" : "")"
               href="@(f.HemaRatingsUrl ?? "#")" target="_blank" rel="noopener">Open HEMA Ratings profile</a>
        </div>
    </section>

    @* ---- Statements: each checkbox auto-submits its own form on change. ---- *@
    <details class="card month-card" open>
        <summary class="month-summary">
            <span class="card-title" style="margin:0;">Statements</span>
        </summary>
        <div class="stack-form">
            <form method="post" action="/profile/field">
                <input type="hidden" name="field" value="gdpr" />
                <label class="attendee-check">
                    <input type="checkbox" name="value" checked="@f.GdprAccepted" onchange="this.form.submit()" />
                    <span>I have read and agree to the GDPR statement.</span>
                </label>
            </form>
            <form method="post" action="/profile/field">
                <input type="hidden" name="field" value="liability" />
                <label class="attendee-check">
                    <input type="checkbox" name="value" checked="@f.LiabilityAccepted" onchange="this.form.submit()" />
                    <span>I have read and agree to the liability statement.</span>
                </label>
            </form>
        </div>
    </details>

    @* ---- Settings ---- *@
    <details class="card month-card" open>
        <summary class="month-summary">
            <span class="card-title" style="margin:0;">Settings</span>
        </summary>
        <div class="stack-form">
            <span class="field-label">User settings</span>

            <label>Full name</label>
            <form method="post" action="/profile/field" class="organiser-input-row">
                <input type="hidden" name="field" value="name" />
                <input type="text" name="value" value="@f.Name" />
                <button type="submit" class="attend-btn">Save</button>
            </form>

            <form method="post" action="/profile/field">
                <input type="hidden" name="field" value="student" />
                <label class="attendee-check">
                    <input type="checkbox" name="value" checked="@f.IsStudent" onchange="this.form.submit()" />
                    <span>I am a student (pays 60% of every fee).</span>
                </label>
            </form>

            <span class="field-label" style="margin-top:12px;">HEMA Ratings profile</span>
            <p class="muted" style="margin:0 0 6px;font-size:13px;">
                Paste your HEMA Ratings fighter id.
            </p>
            <form method="post" action="/profile/field" class="organiser-input-row">
                <input type="hidden" name="field" value="hema" />
                <div class="hema-ratings-row" style="flex:1;">
                    <span class="hema-ratings-prefix">hemaratings.com/fighters/details/</span>
                    <input type="text" name="value" inputmode="numeric" placeholder="0000"
                           value="@(f.HemaRatingsId ?? "")" style="flex:1;min-width:0;" />
                </div>
                <button type="submit" class="attend-btn">Save</button>
            </form>
            @if (Saved == "hema")
            {
                <p class="pay-ok" style="margin:4px 0 0;">&#10003; Saved.</p>
            }
            @if (!string.IsNullOrEmpty(HemaError))
            {
                <p class="pay-due" style="margin:4px 0 0;">@HemaError</p>
            }
        </div>
    </details>
}
else
{
    <section class="card"><p class="muted">Not signed in.</p></section>
}

@code {
    [SupplyParameterFromQuery(Name = "saved")] public string? Saved { get; set; }
    [SupplyParameterFromQuery(Name = "error")] public string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "hemaError")] public string? HemaError { get; set; }

    private Fencer? _fencer;

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureRestoredAsync();

        // Re-read the fresh row from the backend (Auth.CurrentFencer is only the cookie snapshot).
        var me = Auth.CurrentFencer;
        if (me is not null)
        {
            var all = await Sheets.GetFencersAsync();
            _fencer = all.FirstOrDefault(x => x.Id == me.Id) ?? me;
        }
    }
}
