<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net9.0-android35.0</TargetFrameworks>
        <OutputType>Exe</OutputType>
        <RootNamespace>JustAnotherHemaClub</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <DefaultItemExcludes>$(DefaultItemExcludes);Tests\**;UITests\**</DefaultItemExcludes>

        <ApplicationTitle>JAHC Manager</ApplicationTitle>
        <ApplicationId>com.jahc.manager</ApplicationId>
        <ApplicationVersion>4</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.8</ApplicationDisplayVersion>

        <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>

        <!-- Explicit target SDK = API 35 (Android 15), amit a Google Play elvár -->
        <AndroidTargetSdkVersion>35</AndroidTargetSdkVersion>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>

        <!-- Temporarily OFF to isolate the device-only crash -->
        <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
        <RunAOTCompilation>false</RunAOTCompilation>

        <!-- Keep shrinking, but drop obfuscation for now -->
        <AndroidLinkMode>SdkOnly</AndroidLinkMode>
        <AndroidLinkTool>r8</AndroidLinkTool>
        <AndroidEnableObfuscation>true</AndroidEnableObfuscation>
        <AndroidCreateSymbolArchive>true</AndroidCreateSymbolArchive>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.0" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
        <PackageReference Include="Google.Apis.Sheets.v4" Version="1.69.0.3694" />
        <PackageReference Include="Google.Apis.Auth" Version="1.70.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
        <PackageReference Include="Plugin.Fingerprint" Version="3.0.0-beta.1" />
    </ItemGroup>

    <ItemGroup>
        <!-- Service account JSON used by GoogleSheetsService -->
        <MauiAsset Include="Resources\Raw\service-account.json" LogicalName="service-account.json" />
    </ItemGroup>

    <ItemGroup>
        <MauiXaml Update="AppShell.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\Colors.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Resources\Styles\Styles.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\FinancePage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\GdprPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\HomePage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\LiabilityPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\MatchPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\NewTrainingPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\ProfilePage.xaml">
            <Generator></Generator>
        </MauiXaml>
        <MauiXaml Update="Views\RegisterPage.xaml">
            <Generator></Generator>
        </MauiXaml>
        <MauiXaml Update="Views\StatisticsPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TournamentAccessPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TournamentEditorPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TournamentHubPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TournamentsPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\TrainingsHubPage.xaml">
          <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
        <MauiXaml Update="Views\FencersPage.xaml">
            <Generator>MSBuild:Compile</Generator>
        </MauiXaml>
    </ItemGroup>

    <ItemGroup>
        <!-- App Icon: blue background, foreground scaled down so nothing gets cropped -->
        <MauiIcon Include="Resources\AppIcon\appicon2.png" ForegroundFile="Resources\AppIcon\appicon2.png" ForegroundScale="1   " Color="#476FB5" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#5D1312 " BaseSize="128,128" />

        <!-- All images explicitly included, but exclude the app icon source -->
        <MauiImage Include="Resources\Images\**" Exclude="Resources\Images\app_icon_blue.svg" />
    </ItemGroup>

    <ItemGroup Condition="'$(Configuration)' == 'Release'">
        <ProguardConfiguration Include="Platforms\Android\proguard.cfg" />
    </ItemGroup>

    <ItemGroup>
        <TrimmerRootDescriptor Include="Platforms\Android\linker.xml" />
    </ItemGroup>

</Project>